<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OptiGame.Core\OptiGame.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vraies réponses de services externes, gardées telles quelles pour valider les formats -->
    <!-- Sans l'exclusion de bin et obj, les échantillons déjà copiés en sortie y étaient recopiés un niveau plus bas à chaque
         compilation (bin\Debug\net10.0\bin\Debug\…) : 348 017 fichiers le 2026-10-09, compilation bloquée. -->
    <None Include="**\Samples\**" Exclude="$(DefaultItemExcludes)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
