<UserControl x:Class="OptiGame.App.Views.MeasuresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OptiGame.App.ViewModels"
             xmlns:controls="clr-namespace:OptiGame.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MeasuresViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="32,24,32,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="Mesures" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}"
                       Text="Mesurez les FPS d'un jeu avec PresentMon, puis comparez avant et après optimisation. Pour comparer, mesurez la même scène avec les mêmes réglages, idéalement plusieurs fois : quelques pourcents d'écart entre deux captures sont normaux." />
        </StackPanel>

        <!-- PresentMon introuvable -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,16" Style="{StaticResource Banner}"
                Background="{StaticResource Brush.WarningSoft}" BorderBrush="{StaticResource Brush.Warning}">
            <Border.Visibility>
                <Binding Path="HasPresentMon" Converter="{StaticResource InverseBoolToVisibility}" />
            </Border.Visibility>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Choisir PresentMon…" Command="{Binding ChoosePresentMonCommand}" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Body}"
                           Text="PresentMon (outil open source d'Intel) est nécessaire pour mesurer les FPS. Indiquez la version console (PresentMon-x.y.z-x64.exe)." />
            </DockPanel>
        </Border>

        <!-- Nouvelle capture -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Text.Label}" Margin="0,0,0,6" Text="Jeu" />
                        <ComboBox Width="240" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Text.Label}" Margin="0,0,0,6" Text="ou nom de l'exe" />
                        <TextBox Width="160" Text="{Binding CustomExeName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Text.Label}" Margin="0,0,0,6" Text="Durée (s)" />
                        <ComboBox Width="90" ItemsSource="{Binding DurationOptions}" SelectedItem="{Binding SelectedDuration}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Text.Label}" Margin="0,0,0,6" Text="Délai (s)" />
                        <ComboBox Width="90" ItemsSource="{Binding DelayOptions}" SelectedItem="{Binding SelectedDelay}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Text.Label}" Margin="0,0,0,6" Text="Libellé" />
                        <TextBox Width="220" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Ex. « Avant optimisation » ; par défaut : jeu + date" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding StartCaptureCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xE768;" />
                                <TextBlock Margin="8,0,0,0" Text="Démarrer la capture" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Style="{StaticResource Button.Secondary}" Content="Annuler" Command="{Binding CancelCaptureCommand}"
                                Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" Text="{Binding CaptureStatus}" />
                <DockPanel Margin="0,6,0,0" Visibility="{Binding HasPresentMon, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Changer…" Command="{Binding ChoosePresentMonCommand}" />
                    <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center">
                        <Run Text="PresentMon : " /><Run Text="{Binding PresentMonPath, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </Border>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="16" />
                <RowDefinition Height="200" />
            </Grid.RowDefinitions>

            <!-- Captures -->
            <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource Card}" Padding="16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Command="{Binding DeleteSelectedCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Text="&#xE74D;" />
                                <TextBlock Margin="6,0,0,0" Text="Supprimer" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Captures" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Une capture, ou deux (Ctrl+clic) pour les comparer." />
                        </StackPanel>
                    </DockPanel>
                    <ListView x:Name="CaptureList" ItemsSource="{Binding Captures}" SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                              Background="Transparent" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Libellé" Width="150" DisplayMemberBinding="{Binding Label}" />
                                <GridViewColumn Header="Jeu" Width="100" DisplayMemberBinding="{Binding Game}" />
                                <GridViewColumn Header="Date" Width="115" DisplayMemberBinding="{Binding Date}" />
                                <GridViewColumn Header="Profil" Width="80" DisplayMemberBinding="{Binding Profile}" />
                                <GridViewColumn Header="FPS" Width="55" DisplayMemberBinding="{Binding AverageFps}" />
                                <GridViewColumn Header="1 % low" Width="65" DisplayMemberBinding="{Binding OnePercentLow}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- Détail / comparaison -->
            <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource Card}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Aucune capture sélectionnée.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Une capture -->
                        <StackPanel DataContext="{Binding Before}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsComparison, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding Label}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Date}" />
                            <UniformGrid Margin="0,14,0,0" Columns="2">
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="FPS moyens" />
                                    <TextBlock Style="{StaticResource StatValue}" Foreground="{StaticResource Brush.Accent}" Text="{Binding AverageFps}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="1 % low" />
                                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding OnePercentLow}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="0,1 % low" />
                                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding PointOnePercentLow}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="Frametime P99" />
                                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding P99}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Summary}" />
                        </StackPanel>

                        <!-- Comparaison -->
                        <StackPanel Visibility="{Binding IsComparison, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Comparaison" />
                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource Brush.Info}" VerticalAlignment="Center" />
                                <TextBlock Margin="6,0,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Before.Label, StringFormat='Avant : {0}'}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource Brush.Warning}" VerticalAlignment="Center" />
                                <TextBlock Margin="6,0,0,0" Style="{StaticResource Text.Caption}" Text="{Binding After.Label, StringFormat='Après : {0}'}" />
                            </StackPanel>
                            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Comparison}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ComparisonRow}">
                                        <Border Margin="0,3" Padding="10,6" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Control}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Metric}" />
                                                <TextBlock Grid.Column="1" TextAlignment="Right" Style="{StaticResource Text.Body}" Text="{Binding Before}" />
                                                <TextBlock Grid.Column="2" TextAlignment="Right" Style="{StaticResource Text.Body}" Text="{Binding After}" />
                                                <TextBlock Grid.Column="3" TextAlignment="Right" FontWeight="SemiBold" Text="{Binding Change}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBetter}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Ok}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsBetter}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Caption}"
                                       Text="Vert = mieux, rouge = moins bien, gris = écart inférieur à 1 % (dans la marge de variation normale)." />
                        </StackPanel>

                        <TextBlock Margin="0,14,0,0" Style="{StaticResource Text.Caption}"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"
                                   Text="FPS moyens = images ÷ durée. 1 % / 0,1 % low = FPS moyens sur les 1 % / 0,1 % d'images les plus lentes. P99 = 99 % des images sont plus rapides. Calculé sur la cadence de rendu du jeu, chaîne d'affichage principale uniquement (overlays exclus)." />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Graphe -->
            <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="16,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Style="{StaticResource Text.SectionTitle}" FontSize="14"
                               Text="Frametimes — plus bas = mieux ; les pics sont des saccades" />
                    <controls:FrametimeChart Primary="{Binding BeforeFrames}" Secondary="{Binding AfterFrames}" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
