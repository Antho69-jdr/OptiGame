<UserControl x:Class="OptiGame.App.Views.GamePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OptiGame.App.ViewModels"
             xmlns:views="clr-namespace:OptiGame.App.Views"
             xmlns:controls="clr-namespace:OptiGame.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GamePageViewModel}">
    <!-- Fiche du jeu : bannière, puis trois onglets. Deux modèles de validation, nommés à l'écran :
         réglages de partie et propriétés → barre « Enregistrer » ; réglages permanents (Windows, pilote) → « Appliquer… » confirmé. -->
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding Editor.SaveCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Erreur de saisie sous un champ : icône + texte, annoncée -->
        <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Onglet avec point « modifications non enregistrées » -->
        <Style x:Key="DirtyDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Barre d'enregistrement (réglages de partie et propriétés) : hors du défilement, visible s'il y a des modifications -->
        <Border DockPanel.Dock="Bottom" Padding="32,12" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0" Visibility="{Binding Editor.IsDirty, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Content="Abandonner les modifications" Command="{Binding Editor.RevertCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Content="Enregistrer" Command="{Binding Editor.SaveCommand}"
                            AutomationProperties.HelpText="Ctrl+S" ToolTip="Enregistrer (Ctrl+S)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Warning}" />
                    <TextBlock Margin="10,0,0,0" Style="{StaticResource Text.Body}" Text="Modifications non enregistrées" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Fil d'Ariane (hors de l'image) -->
                <StackPanel Margin="28,16,32,0" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Ghost}" Padding="6,2" MinHeight="28" Content="Mes jeux" Command="{Binding BackCommand}"
                            AutomationProperties.Name="Revenir à Mes jeux" ToolTip="Revenir à Mes jeux (Échap)" />
                    <TextBlock Margin="2,0,8,0" Style="{StaticResource Text.Icon}" FontSize="{StaticResource IconSize.Small}"
                               Foreground="{StaticResource Brush.TextMuted}" Text="&#xE76C;" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Secondary}" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </StackPanel>

                <!-- Bannière : hauteur donnée par son contenu (rien n'est rogné en fenêtre étroite) -->
                <Grid Margin="0,8,0,0">
                    <Border Background="{StaticResource Brush.BannerPlaceholder}" />
                    <Border>
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill" AlignmentY="Top" ImageSource="{Binding HeroImage, IsAsync=True}" />
                        </Border.Background>
                    </Border>
                    <Border Background="{StaticResource Brush.BannerFade}" />

                    <DockPanel Margin="32,56,32,24">
                        <Grid DockPanel.Dock="Left" Width="135" Height="180" Margin="0,0,24,0" VerticalAlignment="Bottom">
                            <Border CornerRadius="{DynamicResource Radius.Cover}" Background="{StaticResource Brush.CoverPlaceholder}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.PageTitle}"
                                           Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Initials}" />
                            </Border>
                            <Border CornerRadius="{DynamicResource Radius.Cover}" BorderBrush="{StaticResource Brush.OverlayBorder}" BorderThickness="1"
                                    Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill" ImageSource="{Binding CoverImage, IsAsync=True}" />
                                </Border.Background>
                            </Border>
                        </Grid>

                        <StackPanel VerticalAlignment="Bottom">
                            <Border Margin="{StaticResource Margin.StackS}" HorizontalAlignment="Left" Style="{StaticResource Badge.Success}"
                                    Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource Brush.Ok}" />
                                    <TextBlock Text="Partie en cours" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Text.Hero}" Text="{Binding Name}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding PlaytimeSummary}" />

                            <!-- Une action principale ; le reste dans « … » -->
                            <WrapPanel Margin="0,8,0,0">
                                <controls:IconButton Margin="0,8,8,0" Style="{StaticResource Button.PrimaryLarge}" Glyph="&#xE768;" Label="Jouer"
                                                     Command="{Binding PlayCommand}"
                                                     Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVisibility}}" />
                                <controls:IconButton Margin="0,8,8,0" Style="{StaticResource Button.Secondary}" Glyph="&#xE71A;" Label="Arrêter l'optimisation…"
                                                     Command="{Binding EndSessionCommand}"
                                                     AutomationProperties.HelpText="Restaure tout de suite les réglages d'origine ; le jeu continue de tourner."
                                                     Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                                <controls:IconButton Margin="0,8,8,0" Style="{StaticResource Button.Secondary}" Glyph="&#xE9D2;" Label="Mesurer les FPS"
                                                     Command="{Binding MeasureCommand}" AutomationProperties.HelpText="Ouvre la page Mesures, ce jeu choisi." />
                                <controls:IconButton x:Name="MoreButton" Margin="0,8,0,0" Style="{StaticResource Button.Secondary}" Glyph="&#xE712;"
                                                     IsLabelVisible="False" Label="Plus d'actions" Click="OnMoreClick"
                                                     AutomationProperties.HelpText="Ouvre un menu : voir sur Steam, dock, jaquette, fond, retirer.">
                                    <controls:IconButton.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding StorePageLabel}" Command="{Binding OpenStorePageCommand}"
                                                      Visibility="{Binding HasStorePage, Converter={StaticResource BoolToVisibility}}" />
                                            <MenuItem Command="{Binding TogglePinCommand}" Visibility="{Binding IsDockEnabled, Converter={StaticResource BoolToVisibility}}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Header" Value="Épingler au dock" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Header" Value="Retirer du dock" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="Changer la jaquette…" Command="{Binding ChangeCoverCommand}" />
                                            <MenuItem Header="Changer le fond…" Command="{Binding ChangeBackgroundCommand}" />
                                            <Separator />
                                            <MenuItem Header="Retirer de Mes jeux…" Command="{Binding Editor.DeleteCommand}" />
                                        </ContextMenu>
                                    </controls:IconButton.ContextMenu>
                                </controls:IconButton>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <StackPanel x:Name="Body" Margin="32,16,32,32">
                    <!-- Message de lancement (partagé avec la grille) -->
                    <controls:InfoBar Margin="{StaticResource Margin.StackL}"
                                      Severity="{Binding DataContext.LaunchStatusSeverity, RelativeSource={RelativeSource AncestorType=views:LibraryView}}"
                                      Message="{Binding DataContext.LaunchStatus, RelativeSource={RelativeSource AncestorType=views:LibraryView}}"
                                      IsClosable="True" CloseCommand="{Binding DataContext.DismissLaunchStatusCommand, RelativeSource={RelativeSource AncestorType=views:LibraryView}}"
                                      Visibility="{Binding DataContext.HasLaunchStatus, RelativeSource={RelativeSource AncestorType=views:LibraryView}, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Onglets : flèches pour passer de l'un à l'autre -->
                    <Border Margin="{StaticResource Margin.StackL}" HorizontalAlignment="Left" Padding="3" CornerRadius="{StaticResource Radius.Control}"
                            Background="{StaticResource Brush.Control}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="GameTabs" IsChecked="{Binding IsOverviewTab}"
                                         Content="Vue d'ensemble" AutomationProperties.Name="Vue d'ensemble" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="GameTabs" IsChecked="{Binding IsOptimizationTab}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Optimisation" />
                                    <Ellipse Style="{StaticResource DirtyDot}" Visibility="{Binding Editor.IsOptimizationDirty, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <AutomationProperties.Name>
                                    <MultiBinding StringFormat="{}{0}{1}">
                                        <Binding Source="Optimisation" />
                                        <Binding Path="Editor.IsOptimizationDirty" Converter="{StaticResource DirtySuffix}" />
                                    </MultiBinding>
                                </AutomationProperties.Name>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Segment}" GroupName="GameTabs" IsChecked="{Binding IsPropertiesTab}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Propriétés" />
                                    <Ellipse Style="{StaticResource DirtyDot}" Visibility="{Binding Editor.IsPropertiesDirty, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <AutomationProperties.Name>
                                    <MultiBinding StringFormat="{}{0}{1}">
                                        <Binding Source="Propriétés" />
                                        <Binding Path="Editor.IsPropertiesDirty" Converter="{StaticResource DirtySuffix}" />
                                    </MultiBinding>
                                </AutomationProperties.Name>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- ===== Vue d'ensemble ===== -->
                    <StackPanel x:Name="OverviewTab" Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVisibility}}">
                        <!-- Note sur ce PC : mesurée (PresentMon) ou estimée (configuration requise) -->
                        <Border Margin="{StaticResource Margin.StackL}" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Note sur ce PC" />
                                <StackPanel Visibility="{Binding HasRating, Converter={StaticResource BoolToVisibility}}">
                                    <WrapPanel Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource Text.Stat}" Text="{Binding ScoreText}">
                                            <TextBlock.Foreground>
                                                <Binding Path="RatingLevel" Converter="{StaticResource LevelToBrush}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock Margin="4,0,0,5" VerticalAlignment="Bottom" Style="{StaticResource Text.Secondary}" Text="/ 100" />
                                        <TextBlock Margin="14,0,0,5" VerticalAlignment="Bottom" Style="{StaticResource Text.BodyStrong}" Text="{Binding RatingHeadline}" />
                                        <Border Margin="12,0,0,5" VerticalAlignment="Bottom" Style="{StaticResource Badge.Neutral}">
                                            <TextBlock Text="{Binding RatingKind}" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.BodyStrong}" Text="{Binding PresetText}" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding RatingAdvice}" />
                                    <Expander Margin="0,8,0,0" Style="{StaticResource Expander.Disclosure}" Header="Détails du calcul">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding RatingSource}" />
                                            <Button Margin="-8,2,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Ghost}" Content="Voir sur PCGamingWiki"
                                                    Command="{Binding OpenRequirementsSourceCommand}"
                                                    Visibility="{Binding HasRequirementsLink, Converter={StaticResource BoolToVisibility}}" />
                                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding RatingDetails}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="{Binding StringFormat='• {0}'}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Secondary}" Text="Calcul de la note…"
                                           Visibility="{Binding IsRatingPending, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Secondary}"
                                           Visibility="{Binding HasNoRating, Converter={StaticResource BoolToVisibility}}"
                                           Text="Pas encore de note : configuration requise introuvable (ni Steam ni PCGamingWiki, ou cartes graphiques citées inconnues). Elle apparaîtra après une partie, grâce à la mesure automatique des FPS." />

                                <!-- Réglage utilisé dans le jeu : illisible par OptiGame, indiqué par l'utilisateur (enregistré tout de suite) -->
                                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                    <Label Margin="0,0,10,0" Padding="0" VerticalAlignment="Center" Content="_Mon réglage dans le jeu"
                                           Target="{Binding ElementName=PresetBox}" Foreground="{StaticResource Brush.Text}" />
                                    <ComboBox x:Name="PresetBox" MinWidth="140" ItemsSource="{Binding PlayedPresetOptions}" SelectedItem="{Binding PlayedPreset}"
                                              DisplayMemberPath="Label" AutomationProperties.Name="Mon réglage dans le jeu" />
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Caption}"
                                           Text="OptiGame ne peut pas lire les réglages du jeu : indiquez le vôtre pour un conseil précis. Gardé tout de suite, et noté avec chaque mesure." />
                            </StackPanel>
                        </Border>

                        <!-- Temps de jeu, mesures, disque : deux colonnes, une seule en fenêtre étroite -->
                        <!-- Sous la note : 3 cartes côte à côte si la place le permet (2, puis 1 en fenêtre étroite) ; marge droite négative = cartes alignées sur la note -->
                        <UniformGrid Margin="0,0,-16,0" Columns="{Binding ActualWidth, ElementName=OverviewTab, Converter={StaticResource WidthToColumns}, ConverterParameter='720,880'}">
                            <Border Margin="0,0,16,16" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Temps de jeu" />
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Stat}" Text="{Binding PlaytimeTotal}" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding PlaytimeDetail}" />
                                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding RecentSessions}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SessionRow}">
                                                <DockPanel Margin="0,3">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Body}" Text="{Binding Duration}" />
                                                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Date}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,16,16" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Mesures" />
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding MeasuresSummary}" />
                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Captures}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CaptureItemViewModel}">
                                                <DockPanel Margin="0,4">
                                                    <StackPanel DockPanel.Dock="Right">
                                                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.BodyStrong}"
                                                                   Text="{Binding AverageFps, StringFormat='{}{0} FPS'}" />
                                                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Caption}"
                                                                   Text="{Binding OnePercentLow, StringFormat='1 % low : {0}'}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Date}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,16,16" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Disque du jeu" />
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Secondary}" Text="Lecture du disque…"
                                               Visibility="{Binding IsDiskPending, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding DiskSummary}"
                                               Visibility="{Binding IsDiskUnreadable, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Visibility="{Binding HasDisk, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Stat}" Text="{Binding DiskTile}" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.BodyStrong}" Text="{Binding Disk.Summary}">
                                            <TextBlock.Foreground>
                                                <Binding Path="DiskLevel" Converter="{StaticResource LevelToBrush}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding Disk.Detail}" />
                                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Disk.Advice}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="{Binding StringFormat='• {0}'}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>

                    <!-- ===== Optimisation ===== -->
                    <StackPanel Visibility="{Binding IsOptimizationTab, Converter={StaticResource BoolToVisibility}}">
                        <!-- Réglages de partie : barre « Enregistrer » -->
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Réglages de partie" />
                        <TextBlock Margin="0,4,0,12" Style="{StaticResource Text.Secondary}"
                                   Text="Appliqués quand le jeu démarre, restaurés quand il se ferme. Gardés avec « Enregistrer »." />
                        <Border Margin="{StaticResource Margin.StackXL}" Style="{StaticResource Card}" DataContext="{Binding Editor}">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding Enabled}" Content="Optimiser ce jeu pendant les parties" FontWeight="SemiBold" />
                                <StackPanel Margin="0,8,0,0" IsEnabled="{Binding Enabled}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,8,0,0">
                                            <Label Style="{StaticResource Text.FieldLabel}" Content="_Plan d'alimentation" Target="{Binding ElementName=PowerBox}" />
                                            <ComboBox x:Name="PowerBox" ItemsSource="{Binding PowerSchemeOptions}" SelectedItem="{Binding SelectedPowerScheme}"
                                                      DisplayMemberPath="Label" AutomationProperties.Name="Plan d'alimentation" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,8,0,0">
                                            <Label Style="{StaticResource Text.FieldLabel}" Content="P_riorité du jeu" Target="{Binding ElementName=PriorityBox}" />
                                            <ComboBox x:Name="PriorityBox" ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding SelectedPriority}"
                                                      DisplayMemberPath="Label" AutomationProperties.Name="Priorité du jeu" />
                                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Caption}"
                                                       Text="Effet généralement faible. « Haute » peut rendre le vocal ou le streaming moins réactifs ; certains anti-cheats refusent ce changement (il est alors ignoré)." />
                                        </StackPanel>
                                    </Grid>

                                    <Label Margin="0,16,0,0" Style="{StaticResource Text.FieldLabel}" Content="Programmes à _fermer" Target="{Binding ElementName=NewProcessBox}" />
                                    <TextBlock Margin="{StaticResource Margin.StackS}" Style="{StaticResource Text.Caption}"
                                               Text="Fermés normalement au lancement du jeu, puis arrêtés de force après 5 secondes : les données non enregistrées peuvent être perdues. Jamais les composants de Windows ni les services ; relancés sans droits administrateur." />
                                    <ItemsControl ItemsSource="{Binding ProcessesToClose}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ProcessRowViewModel}">
                                                <Border Margin="0,2" Padding="12,4,4,4" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Control}">
                                                    <DockPanel>
                                                        <controls:IconButton DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Glyph="&#xE711;" IsLabelVisible="False"
                                                                             Label="{Binding ExeName, StringFormat='Ne plus fermer {0}'}" Command="{Binding RemoveCommand}" />
                                                        <CheckBox DockPanel.Dock="Right" Margin="12,0" VerticalAlignment="Center" IsChecked="{Binding Relaunch}"
                                                                  Content="Relancer après" AutomationProperties.Name="{Binding ExeName, StringFormat='Relancer {0} après la partie'}" />
                                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" Text="{Binding ExeName}" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Text.Secondary}" Text="Aucun programme fermé pendant les parties."
                                               Visibility="{Binding HasProcessesToClose, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Button.Secondary}"
                                                Content="Programmes ouverts…" Command="{Binding PickRunningProgramsCommand}" />
                                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Button.Secondary}"
                                                Content="Ajouter" Command="{Binding AddProcessCommand}" />
                                        <Grid>
                                            <TextBox x:Name="NewProcessBox" VerticalContentAlignment="Center" Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Nom du programme à fermer" AutomationProperties.HelpText="Par exemple chrome.exe" />
                                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource Text.Secondary}"
                                                       Foreground="{StaticResource Brush.TextMuted}" Text="ex. chrome.exe">
                                                <TextBlock.Visibility>
                                                    <MultiBinding Converter="{StaticResource EmptyAndUnfocusedToVisibility}">
                                                        <Binding ElementName="NewProcessBox" Path="Text" />
                                                        <Binding ElementName="NewProcessBox" Path="IsKeyboardFocused" />
                                                    </MultiBinding>
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                        </Grid>
                                    </DockPanel>
                                </StackPanel>

                                <!-- Ce qui se passera (toujours visible, généré par le moteur des parties) -->
                                <Border Margin="0,16,0,0" Padding="14,10" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.InfoSoft}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Ce qui se passera" />
                                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Summary}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,1" Style="{StaticResource Text.Secondary}" Text="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Réglages permanents : « Appliquer… » confirmé, « Restaurer l'original… » -->
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Réglages permanents (Windows et pilote)" />
                        <TextBlock Margin="0,4,0,12" Style="{StaticResource Text.Secondary}"
                                   Text="Gardés après la partie. Appliqués tout de suite après confirmation, sans « Enregistrer » ; « Restaurer l'original… » rétablit le réglage d'origine." />

                        <!-- Plafond de FPS : profil NVIDIA du jeu (carte masquée sans pilote NVIDIA) -->
                        <Border Margin="{StaticResource Margin.StackL}" Style="{StaticResource Card}" DataContext="{Binding FrameCap}"
                                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Plafond de FPS (pilote NVIDIA)" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="{Binding ProfileText}" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Body}" Text="{Binding CurrentText}" />
                                <Label Margin="0,12,0,0" Style="{StaticResource Text.FieldLabel}" Content="Nouveau plafond (_FPS)" Target="{Binding ElementName=FpsBox}" />
                                <WrapPanel>
                                    <TextBox x:Name="FpsBox" Width="90" Margin="0,0,8,8" Text="{Binding FpsText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Nouveau plafond de FPS" AutomationProperties.HelpText="0 = aucun plafond" />
                                    <Button Margin="0,0,8,8" Style="{StaticResource Button.Secondary}" Content="Appliquer…" Command="{Binding ApplyCommand}"
                                            AutomationProperties.Name="Appliquer le plafond de FPS…" />
                                    <Button Margin="0,0,8,8" Style="{StaticResource Button.Ghost}" Content="Restaurer l'original…" Command="{Binding UndoCommand}"
                                            AutomationProperties.Name="Restaurer le plafond de FPS d'origine…"
                                            Visibility="{Binding HasAppliedChange, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Margin="0,0,0,8" Style="{StaticResource Button.Ghost}" Content="{Binding UseSuggestionLabel}" Command="{Binding UseSuggestionCommand}"
                                            Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVisibility}}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource FieldError}" Text="{Binding InputError}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="{Binding SuggestionText}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="{Binding AppliedText}" />
                            </StackPanel>
                        </Border>

                        <!-- Graphismes (Windows) : Auto HDR (lecture seule) et carte graphique (PC à plusieurs cartes) -->
                        <Border Style="{StaticResource Card}" DataContext="{Binding Graphics}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Graphismes (Windows)" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}"
                                           Text="Préférences graphiques que Windows garde pour ce jeu, prises en compte au prochain lancement." />
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.BodyStrong}" Text="Auto HDR" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding AutoHdrText}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="{Binding HdrText}" />
                                <controls:IconButton Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Secondary}" Glyph="&#xE8A7;"
                                                     Label="Ouvrir les réglages graphiques de Windows" Command="{Binding OpenWindowsGraphicsSettingsCommand}" />
                                <StackPanel Margin="0,16,0,0" Visibility="{Binding ShowGpu, Converter={StaticResource BoolToVisibility}}">
                                    <Label Style="{StaticResource Text.FieldLabel}" Content="_Carte graphique pour ce jeu" Target="{Binding ElementName=GpuBox}" />
                                    <WrapPanel>
                                        <ComboBox x:Name="GpuBox" MinWidth="240" Margin="0,0,8,8" ItemsSource="{Binding GpuOptions}" SelectedItem="{Binding SelectedGpu}"
                                                  DisplayMemberPath="Label" AutomationProperties.Name="Carte graphique pour ce jeu" />
                                        <Button Margin="0,0,8,8" Style="{StaticResource Button.Secondary}" Content="Appliquer…" Command="{Binding ApplyCommand}"
                                                AutomationProperties.Name="Appliquer la carte graphique…" />
                                        <Button Margin="0,0,0,8" Style="{StaticResource Button.Ghost}" Content="Restaurer l'original…" Command="{Binding RestoreCommand}"
                                                AutomationProperties.Name="Restaurer la carte graphique d'origine…"
                                                Visibility="{Binding HasAppliedChange, Converter={StaticResource BoolToVisibility}}" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding AppliedText}" />
                                </StackPanel>
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Caption}" Text="{Binding GpuNote}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Propriétés ===== -->
                    <StackPanel Visibility="{Binding IsPropertiesTab, Converter={StaticResource BoolToVisibility}}" DataContext="{Binding Editor}">
                        <Border Margin="{StaticResource Margin.StackL}" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Jeu" />
                                <Label Margin="0,12,0,0" Style="{StaticResource Text.FieldLabel}" Content="_Nom" Target="{Binding ElementName=NameBox}" />
                                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nom" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource FieldError}" Text="{Binding NameError}" />
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.BodyStrong}" Text="Fichier .exe surveillé" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Mono}" Text="{Binding ExePath}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}"
                                           Text="Le processus du jeu lui-même (pas son lanceur) : c'est son démarrage qui déclenche les réglages de partie." />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Secondary}" Content="Parcourir…"
                                        Command="{Binding ChangeExeCommand}" AutomationProperties.Name="Choisir un autre fichier .exe…" />
                            </StackPanel>
                        </Border>

                        <Border Margin="{StaticResource Margin.StackL}" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Lancement" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}"
                                           Text="Comment « Jouer » démarre ce jeu. Toujours sans droits administrateur ; les réglages de partie s'appliquent ensuite d'eux-mêmes." />
                                <Label Margin="0,12,0,0" Style="{StaticResource Text.FieldLabel}" Content="_Mode de lancement" Target="{Binding ElementName=LaunchModeBox}" />
                                <ComboBox x:Name="LaunchModeBox" ItemsSource="{Binding LaunchModeOptions}" SelectedItem="{Binding SelectedLaunchMode}"
                                          DisplayMemberPath="Label" AutomationProperties.Name="Mode de lancement" />

                                <StackPanel Visibility="{Binding IsSteamMode, Converter={StaticResource BoolToVisibility}}">
                                    <Label Margin="0,12,0,0" Style="{StaticResource Text.FieldLabel}" Content="Numéro du jeu sur Steam (_appid)" Target="{Binding ElementName=AppIdBox}" />
                                    <TextBox x:Name="AppIdBox" Width="160" HorizontalAlignment="Left" FontFamily="{StaticResource Font.Mono}"
                                             Text="{Binding SteamAppId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Numéro du jeu sur Steam" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}"
                                               Text="Facultatif : retrouvé automatiquement si le jeu est installé dans une bibliothèque Steam." />
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}">
                                    <Label Margin="0,12,0,0" Style="{StaticResource Text.FieldLabel}" Content="_Lanceur" Target="{Binding ElementName=LauncherBox}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Button.Secondary}" Content="Parcourir…"
                                                Command="{Binding BrowseLauncherCommand}" AutomationProperties.Name="Choisir le lanceur…" />
                                        <TextBox x:Name="LauncherBox" VerticalContentAlignment="Center" FontFamily="{StaticResource Font.Mono}"
                                                 Text="{Binding LauncherPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Lanceur" />
                                    </DockPanel>
                                </StackPanel>

                                <Label Margin="0,12,0,0" Style="{StaticResource Text.FieldLabel}" Content="A_rguments (facultatif)" Target="{Binding ElementName=ArgsBox}" />
                                <TextBox x:Name="ArgsBox" FontFamily="{StaticResource Font.Mono}" Text="{Binding LaunchArguments, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Arguments de lancement" />

                                <Border Margin="0,14,0,0" Padding="12,8" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Control}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Caption}" Text="Sera lancé :" />
                                        <TextBlock Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text}" Text="{Binding LaunchPreview}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Button.Danger}"
                                        Content="Retirer de Mes jeux…" Command="{Binding DeleteCommand}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Retirer de Mes jeux" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}"
                                               Text="Seuls ses réglages OptiGame sont supprimés : le jeu reste installé." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
