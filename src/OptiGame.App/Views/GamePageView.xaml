<UserControl x:Class="OptiGame.App.Views.GamePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OptiGame.App.ViewModels"
             xmlns:conv="clr-namespace:OptiGame.App.Converters"
             xmlns:views="clr-namespace:OptiGame.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GamePageViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:PathToImageConverter x:Key="PathToImage" />
    </UserControl.Resources>

    <DockPanel>
        <!-- Barre d'enregistrement : visible seulement s'il y a des modifications -->
        <Border DockPanel.Dock="Bottom" Padding="32,12" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                Visibility="{Binding Editor.IsDirty, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Content="Annuler les modifications" Command="{Binding Editor.RevertCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Content="Enregistrer" Command="{Binding Editor.SaveCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Warning}" />
                    <TextBlock Margin="10,0,0,0" Style="{StaticResource Text.Body}" Text="Modifications non enregistrées" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Bannière -->
                <Grid Height="320">
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1D2633" Offset="0" />
                                <GradientStop Color="#0E1014" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border>
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill" AlignmentY="Top"
                                        ImageSource="{Binding HeroPath, Converter={StaticResource PathToImage}, ConverterParameter=1600}" />
                        </Border.Background>
                    </Border>
                    <!-- Fondu vers le fond de la fenêtre, pour la lisibilité du titre -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#330E1014" Offset="0" />
                                <GradientStop Color="#990E1014" Offset="0.55" />
                                <GradientStop Color="#FF0E1014" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Button Margin="24,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource Button.Secondary}"
                            Background="#990E1014" Command="{Binding BackCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Text="&#xE72B;" />
                            <TextBlock Margin="8,0,0,0" Text="Mes jeux" />
                        </StackPanel>
                    </Button>

                    <DockPanel Margin="32,0,32,24" VerticalAlignment="Bottom">
                        <!-- Jaquette -->
                        <Grid DockPanel.Dock="Left" Width="120" Height="180" Margin="0,0,24,0">
                            <Border CornerRadius="10" Background="{StaticResource Brush.Control}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="34" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Initials}" />
                            </Border>
                            <Border CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1"
                                    Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill" ImageSource="{Binding CoverPath, Converter={StaticResource PathToImage}, ConverterParameter=240}" />
                                </Border.Background>
                            </Border>
                        </Grid>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Command="{Binding TogglePinCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xE718;" />
                                    <TextBlock Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Épingler au dock" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter Property="Text" Value="Retirer du dock" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Command="{Binding ChangeCoverCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xEB9F;" />
                                    <TextBlock Margin="8,0,0,0" Text="Changer la jaquette" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Command="{Binding MeasureCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xE9D2;" />
                                    <TextBlock Margin="8,0,0,0" Text="Mesurer les FPS" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Primary}" Padding="28,10" FontSize="16" Command="{Binding PlayCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="16" Text="&#xE768;" />
                                    <TextBlock Margin="10,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Jouer" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Text" Value="En cours" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom">
                            <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" Margin="0,0,0,8" Background="{StaticResource Brush.Accent}"
                                    Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Session en cours" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.OnAccent}" />
                            </Border>
                            <TextBlock Style="{StaticResource Text.PageTitle}" FontSize="36" Text="{Binding Name}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Mono}" Text="{Binding Editor.ExePath}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}"
                                       Text="{Binding DataContext.LaunchStatus, RelativeSource={RelativeSource AncestorType=views:LibraryView}}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <!-- Réglages -->
                <Grid Margin="32,8,32,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="2*" MinWidth="260" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <!-- Pendant la partie -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="{Binding Editor.Enabled}"
                                              Content="Appliquer automatiquement" />
                                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Pendant la partie" />
                                </DockPanel>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}"
                                           Text="Appliqué quand le jeu démarre, restauré quand il se ferme." />

                                <TextBlock Style="{StaticResource Text.Label}" Text="Plan d'alimentation" />
                                <ComboBox ItemsSource="{Binding Editor.PowerSchemeOptions}" SelectedItem="{Binding Editor.SelectedPowerScheme}" DisplayMemberPath="Label" />

                                <TextBlock Style="{StaticResource Text.Label}" Text="Priorité du processus du jeu" />
                                <ComboBox ItemsSource="{Binding Editor.PriorityOptions}" SelectedItem="{Binding Editor.SelectedPriority}" DisplayMemberPath="Label" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Caption}"
                                           Text="Effet généralement faible. « Haute » peut rendre les autres programmes (vocal, streaming) moins réactifs. Certains anti-cheats refusent ce changement : il est alors simplement ignoré." />
                            </StackPanel>
                        </Border>

                        <!-- Lancement -->
                        <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Lancement" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}"
                                           Text="Comment « Jouer » démarre ce jeu. Toujours sans droits administrateur ; le profil s'applique ensuite automatiquement." />

                                <TextBlock Style="{StaticResource Text.Label}" Text="Mode" />
                                <ComboBox ItemsSource="{Binding Editor.LaunchModeOptions}" SelectedItem="{Binding Editor.SelectedLaunchMode}" DisplayMemberPath="Label" />

                                <StackPanel Visibility="{Binding Editor.IsSteamMode, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="Appid Steam" />
                                    <TextBox Width="160" HorizontalAlignment="Left" FontFamily="{StaticResource Font.Mono}"
                                             Text="{Binding Editor.SteamAppId, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}"
                                               Text="Facultatif : retrouvé automatiquement si le jeu est installé dans une bibliothèque Steam." />
                                </StackPanel>

                                <StackPanel Visibility="{Binding Editor.IsLauncherMode, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="Lanceur" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Button.Secondary}"
                                                Content="Parcourir…" Command="{Binding Editor.BrowseLauncherCommand}" />
                                        <TextBox VerticalContentAlignment="Center" FontFamily="{StaticResource Font.Mono}"
                                                 Text="{Binding Editor.LauncherPath, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </StackPanel>

                                <TextBlock Style="{StaticResource Text.Label}" Text="Arguments (facultatif)" />
                                <TextBox FontFamily="{StaticResource Font.Mono}" Text="{Binding Editor.LaunchArguments, UpdateSourceTrigger=PropertyChanged}" />

                                <Border Margin="0,14,0,0" Padding="12,8" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Control}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Caption}" Text="Sera lancé :" />
                                        <TextBlock Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text}" Text="{Binding Editor.LaunchPreview}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Programmes à fermer -->
                        <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Programmes à fermer au lancement" />
                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Editor.ProcessesToClose}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ProcessRowViewModel}">
                                            <Border Margin="0,3" Padding="12,6" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Control}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" ToolTip="Retirer" Command="{Binding RemoveCommand}">
                                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="&#xE711;" />
                                                    </Button>
                                                    <CheckBox DockPanel.Dock="Right" Margin="12,0" VerticalAlignment="Center"
                                                              IsChecked="{Binding Relaunch}" Content="Relancer après" />
                                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" Text="{Binding ExeName}" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,10,0,0">
                                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Button.Secondary}"
                                            Content="Programmes ouverts…" Command="{Binding Editor.PickRunningProgramsCommand}" />
                                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Button.Secondary}"
                                            Content="Ajouter" Command="{Binding Editor.AddProcessCommand}" />
                                    <TextBox VerticalContentAlignment="Center" Text="{Binding Editor.NewProcessName, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Nom de l'exécutable, ex. chrome.exe" />
                                </DockPanel>
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Caption}"
                                           Text="Fermeture normale, puis arrêt forcé après 5 secondes (les données non enregistrées peuvent être perdues). Jamais les composants de Windows ni les services. La relance se fait sans droits administrateur." />
                            </StackPanel>
                        </Border>

                        <!-- Résumé -->
                        <Border Margin="0,16,0,0" Style="{StaticResource Banner}" Background="{StaticResource Brush.InfoSoft}" BorderBrush="{StaticResource Brush.Info}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" FontSize="14" Text="Ce que fera ce profil" />
                                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Editor.Summary}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2" Style="{StaticResource Text.Body}" Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <!-- Temps de jeu -->
                        <Border Margin="0,0,0,16" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="TEMPS DE JEU" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource Font.Display}" FontSize="30" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text}" Text="{Binding PlaytimeTotal}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding PlaytimeDetail}" />
                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding RecentSessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SessionRow}">
                                            <DockPanel Margin="0,3">
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Body}" FontSize="13" Text="{Binding Duration}" />
                                                <TextBlock Style="{StaticResource Text.Caption}" FontSize="13" Text="{Binding Date}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Profil -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Profil" />
                                <TextBlock Style="{StaticResource Text.Label}" Text="Nom" />
                                <TextBox Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource Text.Label}" Text="Exécutable surveillé" />
                                <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding Editor.ExePath}" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.SecondarySmall}"
                                        Content="Changer d'exécutable…" Command="{Binding Editor.ChangeExeCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- Captures -->
                        <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Dernières mesures" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Caption}" Text="Aucune mesure pour ce jeu. Utilisez « Mesurer les FPS »."
                                           Visibility="{Binding HasCaptures, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Captures}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CaptureItemViewModel}">
                                            <Border Margin="0,4" Padding="12,8" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Control}">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}"
                                                                   Text="{Binding AverageFps, StringFormat='{}{0} FPS'}" />
                                                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Caption}"
                                                                   Text="{Binding OnePercentLow, StringFormat='1 % low {0}'}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Date}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Button Margin="0,16,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Danger}"
                                Content="Retirer ce jeu" Command="{Binding Editor.DeleteCommand}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
