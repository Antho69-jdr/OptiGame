<UserControl x:Class="OptiGame.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OptiGame.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DriversViewModel}"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <DockPanel Margin="32,24,32,0">
        <!-- En-tête de page -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Button.Secondary}" Command="{Binding SearchCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xE72C;" />
                    <TextBlock Margin="8,0,0,0" Text="Rechercher à nouveau" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Pilotes" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}"
                           Text="Compare vos pilotes aux dernières versions publiées. Lecture seule : rien n'est téléchargé ni installé." />
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,24">
            <StackPanel>
                <!-- Carte graphique -->
                <Border Margin="0,0,0,16" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Carte graphique" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="{Binding GpuStatus}" />
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Gpus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GpuDriverItemViewModel}">
                                    <StackPanel Margin="0,10,0,0">
                                        <DockPanel>
                                            <Border x:Name="StateBadge" DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{StaticResource Brush.InfoSoft}">
                                                <TextBlock x:Name="StateText" Text="{Binding StateLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Info}" />
                                            </Border>
                                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" FontSize="16" Text="{Binding Name}" />
                                        </DockPanel>
                                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Body}" Text="{Binding Message}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding Installed}" />
                                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Latest}"
                                                   Visibility="{Binding HasLatest, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Secondary}"
                                                Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding DetailsUrl}"
                                                Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Text="&#xE8A7;" />
                                                <TextBlock Margin="8,0,0,0" Text="Notes de version (nvidia.com)" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                            <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                            <Setter TargetName="StateBadge" Property="Background" Value="{StaticResource Brush.WarningSoft}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsUpToDate}" Value="True">
                                            <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Brush.Ok}" />
                                            <Setter TargetName="StateBadge" Property="Background" Value="{StaticResource Brush.OkSoft}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,14,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="Confidentialité : seul le modèle de votre carte graphique est envoyé au service de recherche de pilotes de NVIDIA." />
                    </StackPanel>
                </Border>

                <!-- Windows Update -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Autres pilotes (Windows Update)" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="{Binding UpdatesStatus}" />
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Updates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WindowsUpdateDriverItemViewModel}">
                                    <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Control}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Details}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Caption}" Text="{Binding HiddenUpdatesNote}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="Ces pilotes viennent du catalogue de Windows Update. N'installez que ceux d'un matériel que vous utilisez (par exemple, les pilotes Samsung servent aux téléphones branchés en USB)." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
