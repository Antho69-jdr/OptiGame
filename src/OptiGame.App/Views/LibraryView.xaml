<UserControl x:Class="OptiGame.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OptiGame.App.ViewModels"
             xmlns:views="clr-namespace:OptiGame.App.Views"
             xmlns:conv="clr-namespace:OptiGame.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LibraryViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:PathToImageConverter x:Key="PathToImage" />

        <!-- Jaquette cliquable : image arrondie (ImageBrush), léger zoom et liseré d'accent au survol -->
        <Style x:Key="CoverCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,20,24" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Width="176" Background="Transparent">
                            <Grid x:Name="Cover" Height="264" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <!-- Remplaçant sans jaquette : dégradé + initiales -->
                                <Border CornerRadius="10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#243040" Offset="0" />
                                            <GradientStop Color="#151A22" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Font.Display}"
                                               FontSize="44" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Initials}" />
                                </Border>
                                <Border CornerRadius="10" Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill" ImageSource="{Binding CoverPath, Converter={StaticResource PathToImage}, ConverterParameter=352}" />
                                    </Border.Background>
                                </Border>
                                <Border x:Name="Outline" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" />
                                <!-- Bouton « Jouer » au survol -->
                                <Button x:Name="PlayButton" Width="48" Height="48" Margin="0,0,10,10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Visibility="Collapsed" Cursor="Hand" ToolTip="Jouer" AutomationProperties.Name="{Binding Name, StringFormat='Jouer à {0}'}"
                                        Command="{Binding DataContext.PlayCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Round" CornerRadius="24" Background="{StaticResource Brush.Accent}">
                                                <TextBlock Margin="3,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.Icon}"
                                                           FontSize="18" Foreground="{StaticResource Brush.OnAccent}" Text="&#xE768;" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Round" Property="Background" Value="{StaticResource Brush.AccentHover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <!-- Pastilles -->
                                <StackPanel Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.Accent}"
                                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="En cours" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.OnAccent}" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Background="#CC0E1014"
                                            Visibility="{Binding Enabled, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="Profil désactivé" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock Margin="2,10,2,0" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}" />
                            <TextBlock Margin="2,2,2,0" Style="{StaticResource Text.Caption}" Text="{Binding ExeName}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="PlayButton" Property="Visibility" Value="Visible" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Grille -->
        <DockPanel Margin="32,24,32,0" Visibility="{Binding IsGridVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="220" Margin="0,0,10,0">
                        <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Filtrer les jeux" />
                        <!-- Texte indicatif tant que le champ est vide -->
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource Text.Caption}" FontSize="14"
                                   Text="Filtrer les jeux…">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource EmptyAndUnfocusedToVisibility}">
                                    <Binding ElementName="SearchBox" Path="Text" />
                                    <Binding ElementName="SearchBox" Path="IsKeyboardFocused" />
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>
                    <Button Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Command="{Binding ScanGamesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xE721;" />
                            <TextBlock Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Rechercher des jeux installés" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                <Setter Property="Text" Value="Recherche en cours…" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding AddGameCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xE710;" />
                            <TextBlock Margin="8,0,0,0" Text="Ajouter un jeu" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="Mes jeux" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding Subtitle}" />
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" Text="{Binding LaunchStatus}" />
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" Style="{StaticResource Text.Caption}" Text="{Binding ArtworkStatus}" />

            <Grid>
                <!-- Bibliothèque vide -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                            Visibility="{Binding HasGames, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Icon}" FontSize="48" Foreground="{StaticResource Brush.TextMuted}" Text="&#xE7FC;" />
                    <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.SectionTitle}" Text="Aucun jeu pour l'instant" />
                    <TextBlock Margin="0,8,0,0" TextAlignment="Center" Style="{StaticResource Text.Secondary}"
                               Text="Lancez une recherche des jeux installés (Steam et vos dossiers de jeux), ou ajoutez un jeu en choisissant son fichier .exe." />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding GamesView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                                <Button Style="{StaticResource CoverCard}" AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- Page du jeu. Modèle implicite (par type) et non ContentTemplate : avec un ContentTemplate explicite,
             WPF instancie la page même quand OpenGame est null, en lui donnant le ViewModel de la bibliothèque. -->
        <ContentControl Content="{Binding OpenGame}" Focusable="False"
                        Visibility="{Binding IsGridVisible, Converter={StaticResource InverseBoolToVisibility}}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:GamePageViewModel}">
                    <views:GamePageView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</UserControl>
