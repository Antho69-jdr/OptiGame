<UserControl x:Class="OptiGame.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OptiGame.App.ViewModels"
             xmlns:views="clr-namespace:OptiGame.App.Views"
             xmlns:conv="clr-namespace:OptiGame.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LibraryViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:PathToImageConverter x:Key="PathToImage" />

        <!-- Jaquette cliquable : image arrondie (ImageBrush), léger zoom et liseré d'accent au survol -->
        <Style x:Key="CoverCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,20,24" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Width="198" Background="Transparent">
                            <Grid x:Name="Cover" Height="264" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <!-- Remplaçant sans jaquette : dégradé + initiales -->
                                <Border CornerRadius="10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#243040" Offset="0" />
                                            <GradientStop Color="#151A22" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Font.Display}"
                                               FontSize="44" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Initials}" />
                                </Border>
                                <Border CornerRadius="10" Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill" ImageSource="{Binding CoverPath, Converter={StaticResource PathToImage}, ConverterParameter=396}" />
                                    </Border.Background>
                                </Border>
                                <Border x:Name="Outline" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" />
                                <!-- Bouton « Jouer » au survol -->
                                <Button x:Name="PlayButton" Width="48" Height="48" Margin="0,0,10,10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Visibility="Collapsed" Cursor="Hand" ToolTip="Jouer" AutomationProperties.Name="{Binding Name, StringFormat='Jouer à {0}'}"
                                        Command="{Binding DataContext.PlayCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Round" CornerRadius="24" Background="{StaticResource Brush.Accent}">
                                                <TextBlock Margin="3,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.Icon}"
                                                           FontSize="18" Foreground="{StaticResource Brush.OnAccent}" Text="&#xE768;" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Round" Property="Background" Value="{StaticResource Brush.AccentHover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <!-- Coin haut gauche : épingle du dock, puis pastilles -->
                                <StackPanel Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal">
                                    <!-- Épinglé : toujours visible (épingle pleine) ; sinon seulement au survol. Hidden et non
                                         Collapsed : la place reste réservée, les pastilles ne bougent pas au survol. -->
                                    <Button x:Name="PinButton" Width="32" Height="32" Cursor="Hand" Visibility="Hidden"
                                            Command="{Binding DataContext.TogglePinCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Round" CornerRadius="16" Background="#CC0E1014" BorderThickness="1" BorderBrush="#33FFFFFF">
                                                    <TextBlock x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.Icon}"
                                                               FontSize="14" Foreground="{StaticResource Brush.Text}" Text="&#xE718;" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter TargetName="Glyph" Property="Text" Value="&#xE841;" />
                                                        <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Round" Property="Background" Value="#F0181C23" />
                                                        <Setter TargetName="Round" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="ToolTip" Value="Épingler au dock" />
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Name, StringFormat='Épingler {0} au dock'}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter Property="ToolTip" Value="Retirer du dock" />
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name, StringFormat='Retirer {0} du dock'}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <StackPanel Margin="6,0,0,0">
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.Accent}"
                                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="En cours" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.OnAccent}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="#CC0E1014"
                                                Visibility="{Binding Enabled, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock Text="Profil désactivé" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <TextBlock Margin="2,10,2,0" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}" />
                            <StackPanel Margin="2,3,2,0" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Icon}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}" Text="&#xE823;" />
                                <TextBlock Margin="5,0,0,0" Style="{StaticResource Text.Caption}" Text="{Binding PlaytimeText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="PinButton" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="PlayButton" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PinButton" Property="Visibility" Value="Visible" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Grille -->
        <DockPanel Margin="32,24,32,0" Visibility="{Binding IsGridVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="170" Margin="0,0,10,0" VerticalAlignment="Center" ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}" AutomationProperties.Name="Trier les jeux" ToolTip="Trier" />
                    <Grid Width="220" Margin="0,0,10,0">
                        <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Filtrer les jeux" />
                        <!-- Texte indicatif tant que le champ est vide -->
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource Text.Caption}" FontSize="14"
                                   Text="Filtrer les jeux…">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource EmptyAndUnfocusedToVisibility}">
                                    <Binding ElementName="SearchBox" Path="Text" />
                                    <Binding ElementName="SearchBox" Path="IsKeyboardFocused" />
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>
                    <Button Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Command="{Binding ScanGamesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xE721;" />
                            <TextBlock Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Rechercher des jeux installés" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                <Setter Property="Text" Value="Recherche en cours…" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding AddGameCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xE710;" />
                            <TextBlock Margin="8,0,0,0" Text="Ajouter un jeu" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="Mes jeux" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding Subtitle}" />
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" Style="{StaticResource Text.Status}" Text="{Binding LaunchStatus}" />
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" Text="{Binding ArtworkStatus}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Status}">
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Nouveaux jeux Steam installés : rien n'est ajouté sans clic -->
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding NewGames.Proposals}"
                          Visibility="{Binding NewGames.HasProposals, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Style="{StaticResource Banner}" Background="{StaticResource Brush.AccentSoft}" BorderBrush="{StaticResource Brush.Accent}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Margin="0,0,8,0" Style="{StaticResource Button.Primary}" Content="Ajouter à Mes jeux"
                                            Command="{Binding DataContext.NewGames.AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='Ajouter {0} à Mes jeux'}" />
                                    <Button Style="{StaticResource Button.Ghost}" Content="Ignorer"
                                            Command="{Binding DataContext.NewGames.IgnoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='Ignorer {0}'}" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource Text.Icon}"
                                           FontSize="18" Foreground="{StaticResource Brush.Accent}" Text="&#xE7FC;" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold">
                                        <Run Text="Nouveau jeu Steam installé : " /><Run Text="{Binding Name, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Detail}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <!-- Bibliothèque vide -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                            Visibility="{Binding HasGames, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Icon}" FontSize="48" Foreground="{StaticResource Brush.TextMuted}" Text="&#xE7FC;" />
                    <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.SectionTitle}" Text="Aucun jeu pour l'instant" />
                    <TextBlock Margin="0,8,0,0" TextAlignment="Center" Style="{StaticResource Text.Secondary}"
                               Text="Lancez une recherche des jeux installés (Steam et vos dossiers de jeux), ou ajoutez un jeu en choisissant son fichier .exe." />
                </StackPanel>

                <!-- Le ScrollViewer rogne ce qui dépasse de ses bords : la marge négative + la marge intérieure
                     laissent 12 px au zoom de survol (1,03) sur la première rangée et la première colonne,
                     sans déplacer les jaquettes. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="-12,-8,0,0">
                    <ItemsControl ItemsSource="{Binding GamesView}" Margin="12,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                                <Button Style="{StaticResource CoverCard}" AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <!-- Le menu contextuel n'hérite pas de l'arbre visuel : la bibliothèque passe par Tag. -->
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Jouer" Command="{Binding PlayCardCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Ouvrir la page du jeu" Command="{Binding OpenCardCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Command="{Binding TogglePinCardCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Header" Value="Épingler au dock" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsPinned, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                                <Setter Property="Header" Value="Retirer du dock" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- Page du jeu. Modèle implicite (par type) et non ContentTemplate : avec un ContentTemplate explicite,
             WPF instancie la page même quand OpenGame est null, en lui donnant le ViewModel de la bibliothèque. -->
        <ContentControl Content="{Binding OpenGame}" Focusable="False"
                        Visibility="{Binding IsGridVisible, Converter={StaticResource InverseBoolToVisibility}}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:GamePageViewModel}">
                    <views:GamePageView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</UserControl>
