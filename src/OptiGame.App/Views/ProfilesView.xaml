<UserControl x:Class="OptiGame.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OptiGame.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProfilesViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Liste des profils -->
        <DockPanel Grid.Column="0">
            <Button DockPanel.Dock="Top" Padding="12,6" Margin="0,0,0,6" Command="{Binding ScanGamesCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="Rechercher des jeux installés…" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                <Setter Property="Content" Value="Recherche en cours…" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button DockPanel.Dock="Top" Padding="12,6" Margin="0,0,0,8" Content="Ajouter un jeu à la main (.exe)…" Command="{Binding AddGameCommand}" />
            <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="#E65100" FontSize="12" TextWrapping="Wrap"
                       Text="Enregistrez ou annulez les modifications pour changer de profil.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanChangeSelection}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" IsEnabled="{Binding CanChangeSelection}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProfileListItem}">
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" Foreground="#666" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <TextBlock Grid.Column="2" Foreground="#666" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                   Text="Ajoutez un jeu en choisissant son fichier .exe. Un profil décrit ce qu'OptiGame fait quand ce jeu démarre ; tout est restauré à sa fermeture.">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasProfiles}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Éditeur -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" DataContext="{Binding Editor}">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="16">
                <StackPanel d:DataContext="{d:DesignInstance vm:ProfileEditorViewModel}">
                    <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Nom du profil" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="4" />

                    <TextBlock Style="{StaticResource Label}" Text="Exécutable du jeu" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,2" Content="Changer…" Command="{Binding ChangeExeCommand}" />
                        <TextBox Text="{Binding ExePath, Mode=OneWay}" IsReadOnly="True" Padding="4" Foreground="#444" />
                    </DockPanel>

                    <CheckBox Margin="0,12,0,0" IsChecked="{Binding Enabled}" Content="Appliquer ce profil automatiquement quand le jeu démarre" />

                    <TextBlock Style="{StaticResource Label}" Text="Plan d'alimentation pendant la session" />
                    <ComboBox ItemsSource="{Binding PowerSchemeOptions}" SelectedItem="{Binding SelectedPowerScheme}" DisplayMemberPath="Label" />

                    <TextBlock Style="{StaticResource Label}" Text="Priorité du processus du jeu" />
                    <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding SelectedPriority}" DisplayMemberPath="Label" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Effet généralement faible. « Haute » peut rendre les autres programmes (vocal, streaming) moins réactifs. Certains anti-cheats refusent ce changement : il est alors simplement ignoré." />

                    <TextBlock Style="{StaticResource Label}" Text="Programmes à fermer au lancement du jeu" />
                    <ItemsControl ItemsSource="{Binding ProcessesToClose}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProcessRowViewModel}">
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Padding="8,0" Content="Retirer" Command="{Binding RemoveCommand}" />
                                    <CheckBox DockPanel.Dock="Right" Margin="12,0" VerticalAlignment="Center"
                                              IsChecked="{Binding Relaunch}" Content="Relancer après la session" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding ExeName}" FontFamily="Consolas" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,2" Content="Choisir parmi les programmes ouverts…"
                                Command="{Binding PickRunningProgramsCommand}" />
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,2" Content="Ajouter" Command="{Binding AddProcessCommand}" />
                        <TextBox Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}" Padding="4" ToolTip="Nom de l'exécutable, ex. chrome.exe" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Chaque programme est d'abord fermé normalement, puis arrêté de force s'il ne s'est pas fermé après 5 secondes (les données non enregistrées peuvent alors être perdues). Seuls vos programmes sont concernés : jamais les composants de Windows ni les services. La relance se fait sans droits administrateur." />

                    <Border Margin="0,16,0,0" Padding="12" Background="#F1F6FD" BorderBrush="#BBDEFB" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Ce que fera ce profil" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Summary}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <DockPanel Margin="0,16,0,0">
                        <Button DockPanel.Dock="Left" Padding="12,6" Content="Supprimer le profil" Command="{Binding DeleteCommand}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#E65100" Text="Modifications non enregistrées"
                                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                            <Button Padding="12,6" Margin="0,0,8,0" Content="Annuler les modifications" Command="{Binding RevertCommand}"
                                    Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                            <Button Padding="16,6" Content="Enregistrer" Command="{Binding SaveCommand}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
