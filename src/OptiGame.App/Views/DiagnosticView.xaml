<UserControl x:Class="OptiGame.App.Views.DiagnosticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OptiGame.App.ViewModels"
             xmlns:conv="clr-namespace:OptiGame.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DiagnosticViewModel}">
    <UserControl.Resources>
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="FixButtonTemplate" DataType="{x:Type vm:FixViewModel}">
            <Button Margin="0,12,8,0" HorizontalAlignment="Left" Style="{StaticResource Button.Primary}" Command="{Binding ApplyCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" />
                    <TextBlock Margin="10,0,0,0" Opacity="0.7" FontWeight="Normal" Text="{Binding Badges}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Corps d'un contrôle (corrections, lien, détails, options avancées) : commun aux cartes et aux lignes repliables -->
        <DataTemplate x:Key="CheckBody" DataType="{x:Type vm:DiagnosticItemViewModel}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Fixes}" ItemTemplate="{StaticResource FixButtonTemplate}" />

                <!-- Lien vers une autre page (n'applique rien) -->
                <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Secondary}"
                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding LinkTarget}" AutomationProperties.Name="{Binding LinkLabel}"
                        Visibility="{Binding HasLink, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Text="&#xE896;" />
                        <TextBlock Margin="8,0,0,0" Text="{Binding LinkLabel}" />
                    </StackPanel>
                </Button>

                <Expander Margin="0,10,0,0" Header="Détails et explication" Foreground="{StaticResource Brush.TextSecondary}">
                    <StackPanel Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Details}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Text.Mono}" Margin="0,1" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding Explanation}" TextWrapping="Wrap"
                                   Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Expander>

                <Expander Margin="0,6,0,0" Header="Options avancées" Foreground="{StaticResource Brush.Danger}"
                          Visibility="{Binding HasAdvancedFixes, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding AdvancedFixes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FixViewModel}">
                                <Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Danger}" Command="{Binding ApplyCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" />
                                        <TextBlock Margin="10,0,0,0" Opacity="0.7" FontWeight="Normal" Text="{Binding Badges}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </DataTemplate>

        <!-- Ligne repliable d'un contrôle (« À savoir » et « OK ») -->
        <DataTemplate x:Key="CheckRow" DataType="{x:Type vm:DiagnosticItemViewModel}">
            <Expander Style="{StaticResource Expander.Row}" AutomationProperties.Name="{Binding Title}">
                <Expander.Header>
                    <DockPanel>
                        <Ellipse Width="9" Height="9" Margin="2,0,19,0" VerticalAlignment="Center" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Width="280" VerticalAlignment="Center" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Secondary}" Text="{Binding Summary}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </DockPanel>
                </Expander.Header>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CheckBody}" />
            </Expander>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="32,24,32,0">
        <!-- En-tête de page : titre, vue Simple / Avancé, nouvelle analyse -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Button.Secondary}" Command="{Binding RunCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xE72C;" />
                    <TextBlock Margin="8,0,0,0" Text="Relancer l'analyse" />
                </StackPanel>
            </Button>
            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Padding="3" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Control}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="DiagnosticView" Style="{StaticResource Segment}" Content="Simple" IsChecked="{Binding IsSimple}" />
                    <RadioButton GroupName="DiagnosticView" Style="{StaticResource Segment}" Content="Avancé" IsChecked="{Binding IsAdvanced}" />
                </StackPanel>
            </Border>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Diagnostic" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding StatusText}" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,24">
            <Grid>
                <!-- ===== Vue Simple ===== -->
                <StackPanel Visibility="{Binding IsSimple, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card}" Padding="28,24">
                        <DockPanel>
                            <!-- Pastille d'état -->
                            <Border DockPanel.Dock="Left" Width="64" Height="64" Margin="0,0,24,0" VerticalAlignment="Top" CornerRadius="{StaticResource Radius.Round}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Brush.WarningSoft}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOptimized}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.OkSoft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock HorizontalAlignment="Center" FontSize="28">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                                            <Setter Property="Text" Value="&#xE945;" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOptimized}" Value="True">
                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Ok}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.PageTitle}" FontSize="24" Text="{Binding Headline}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding CountsText}" />

                                <WrapPanel Margin="0,18,0,0">
                                    <Button Margin="0,0,10,8" Padding="24,10" FontSize="15" Style="{StaticResource Button.Primary}"
                                            Command="{Binding ActivateAllCommand}" AutomationProperties.Name="Activer les optimisations">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="15" Text="&#xE945;" />
                                            <TextBlock Margin="10,0,0,0" Text="{Binding ActivateLabel}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="0,0,10,8" Padding="20,10" Style="{StaticResource Button.Secondary}"
                                            Command="{Binding DeactivateAllCommand}" AutomationProperties.Name="Désactiver les optimisations"
                                            Visibility="{Binding HasDiagnosticFixesApplied, Converter={StaticResource BoolToVisibility}}"
                                            Content="{Binding DeactivateLabel}" />
                                </WrapPanel>

                                <!-- Ce que fera le bouton -->
                                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasRecommended, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Text="LE BOUTON APPLIQUERA (APRÈS CONFIRMATION)" />
                                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding RecommendedTitles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,2" Style="{StaticResource Text.Secondary}" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Déjà actives -->
                                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasDiagnosticFixesApplied, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Text="OPTIMISATIONS ACTIVES (ANNULABLES)" />
                                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding AppliedTitles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" Style="{StaticResource Text.Icon}" FontSize="12"
                                                               Foreground="{StaticResource Brush.Ok}" Text="&#xE73E;" />
                                                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding}" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- À faire soi-même -->
                    <StackPanel Margin="0,24,0,0" Visibility="{Binding HasManualItems, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Margin="2,0,0,10" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Text="À FAIRE DE VOTRE CÔTÉ (OPTIGAME NE PEUT PAS LE FAIRE SEUL)" />
                        <ItemsControl ItemsSource="{Binding ManualItems}" ItemTemplate="{StaticResource CheckRow}" />
                    </StackPanel>

                    <!-- Réglages facultatifs -->
                    <Border Margin="0,16,0,0" Style="{StaticResource Banner}" Background="{StaticResource Brush.InfoSoft}" BorderBrush="{StaticResource Brush.Info}"
                            Visibility="{Binding HasOptional, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Button.SecondarySmall}"
                                    Content="Vue Avancé" Command="{Binding ShowAdvancedCommand}" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="{Binding OptionalText}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Vue Avancé ===== -->
                <StackPanel Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVisibility}}">
                    <!-- Corrections appliquées par OptiGame, annulables une à une -->
                    <Expander Style="{StaticResource Expander.Row}" AutomationProperties.Name="Corrections appliquées par OptiGame"
                              Visibility="{Binding HasAppliedFixes, Converter={StaticResource BoolToVisibility}}">
                        <Expander.Header>
                            <DockPanel>
                                <TextBlock Width="30" Style="{StaticResource Text.Icon}" Foreground="{StaticResource Brush.Ok}" Text="&#xE73E;" />
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="Corrections appliquées par OptiGame" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}"
                                           Text="{Binding AppliedFixes.Count, StringFormat='{}{0} active(s), annulables'}" />
                            </DockPanel>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding AppliedFixes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AppliedFixViewModel}">
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Button.SecondarySmall}"
                                                Content="Annuler" Command="{Binding UndoCommand}" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding What}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding AppliedAt}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <!-- À corriger : grandes cartes -->
                    <TextBlock Margin="2,16,0,10" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Text="{Binding AttentionHeader}" />
                    <TextBlock Margin="2,0,0,4" Text="Rien à corriger.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AttentionItems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding AttentionItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DiagnosticItemViewModel}">
                                <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}"
                                                    Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Soft}">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                            </Border>
                                            <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,12,0" VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding Title}" />
                                        </DockPanel>
                                        <TextBlock Margin="22,6,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding Summary}" TextWrapping="Wrap" />
                                        <ContentPresenter Margin="22,0,0,0" Content="{Binding}" ContentTemplate="{StaticResource CheckBody}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- À savoir et OK : lignes repliables -->
                    <TextBlock Margin="2,16,0,10" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Text="{Binding InfoHeader}" />
                    <ItemsControl ItemsSource="{Binding InfoItems}" ItemTemplate="{StaticResource CheckRow}" />
                    <TextBlock Margin="2,16,0,10" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Text="{Binding OkHeader}" />
                    <ItemsControl ItemsSource="{Binding OkItems}" ItemTemplate="{StaticResource CheckRow}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
