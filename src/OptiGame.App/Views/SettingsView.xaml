<UserControl x:Class="OptiGame.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OptiGame.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,24">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="Paramètres" />

            <!-- Démarrage -->
            <Border Margin="0,20,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Démarrage" />
                    <CheckBox Margin="0,14,0,0" IsChecked="{Binding AutoStartEnabled}"
                              Content="Démarrer OptiGame à l'ouverture de session (dans la zone de notification)" />
                    <TextBlock Margin="28,6,0,0" Style="{StaticResource Text.Caption}"
                               Text="Crée une tâche planifiée « OptiGame » qui lance l'appli avec les droits administrateur, sans invite UAC. C'est nécessaire pour détecter vos jeux sans ouvrir OptiGame, et pour restaurer les réglages dès l'ouverture de session si OptiGame s'était arrêté pendant une partie. Décocher supprime la tâche." />
                    <TextBlock Margin="28,6,0,0" Style="{StaticResource Text.Caption}">
                        <Run Text="Programme lancé : " /><Run Text="{Binding ExePath, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Dock -->
            <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Dock" />
                    <CheckBox Margin="0,14,0,0" IsChecked="{Binding DockEnabled}" Content="Afficher le dock des jeux épinglés" />
                    <TextBlock Margin="28,6,0,0" Style="{StaticResource Text.Caption}"
                               Text="Épinglez des jeux depuis « Mes jeux » (page du jeu, ou clic droit sur une jaquette). Clic pour jouer, clic droit pour les options, glisser pour réordonner. Le dock se masque pendant vos parties et quand une application est en plein écran." />
                    <WrapPanel Margin="28,6,0,0">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Position" />
                            <ComboBox Width="160" ItemsSource="{Binding DockEdgeOptions}" SelectedItem="{Binding SelectedDockEdge}" DisplayMemberPath="Label" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Format des icônes" />
                            <ComboBox Width="220" ItemsSource="{Binding DockShapeOptions}" SelectedItem="{Binding SelectedDockShape}" DisplayMemberPath="Label" />
                        </StackPanel>
                    </WrapPanel>
                    <!-- Delay : l'enregistrement attend que le curseur soit immobile (pas une écriture disque par pixel). -->
                    <TextBlock Margin="28,0,0,0" Style="{StaticResource Text.Label}">
                        <Run Text="Taille des icônes : " /><Run Text="{Binding Value, ElementName=SizeSlider, Mode=OneWay, StringFormat='{}{0:0} px'}" />
                    </TextBlock>
                    <Slider x:Name="SizeSlider" Margin="28,0,0,0" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                            Minimum="{Binding MinDockIconSize, Mode=OneTime}" Maximum="{Binding MaxDockIconSize, Mode=OneTime}"
                            TickFrequency="4" IsSnapToTickEnabled="True" SmallChange="4" LargeChange="16"
                            Value="{Binding DockIconSize, Delay=250}" AutomationProperties.Name="Taille des icônes du dock" />
                    <TextBlock Margin="28,0,0,0" Style="{StaticResource Text.Label}">
                        <Run Text="Opacité du fond : " /><Run Text="{Binding Value, ElementName=OpacitySlider, Mode=OneWay, StringFormat='{}{0:0} %'}" />
                    </TextBlock>
                    <Slider x:Name="OpacitySlider" Margin="28,0,0,0" HorizontalAlignment="Left" Width="420"
                            Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"
                            Value="{Binding DockOpacityPercent, Delay=250}" AutomationProperties.Name="Opacité du fond du dock" />
                    <CheckBox Margin="28,14,0,0" IsChecked="{Binding DockAutoHide}"
                              Content="Masquer automatiquement (approchez la souris du bord de l'écran pour l'afficher)" />
                    <TextBlock Margin="56,6,0,0" Style="{StaticResource Text.Caption}"
                               Text="Sans masquage automatique, le dock reste collé au bureau : derrière vos fenêtres, visible quand rien ne le recouvre." />
                    <StackPanel Margin="56,8,0,0" IsEnabled="{Binding DockAutoHide}">
                        <TextBlock Style="{StaticResource Text.Label}">
                            <Run Text="Se masque après : " /><Run Text="{Binding Value, ElementName=HideDelaySlider, Mode=OneWay, StringFormat='{}{0:0.0} s', ConverterCulture=fr-FR}" />
                        </TextBlock>
                        <Slider x:Name="HideDelaySlider" HorizontalAlignment="Left" Width="392"
                                Minimum="{Binding MinDockHideDelay, Mode=OneTime}" Maximum="{Binding MaxDockHideDelay, Mode=OneTime}"
                                TickFrequency="0.1" IsSnapToTickEnabled="True" SmallChange="0.1" LargeChange="0.5"
                                Value="{Binding DockHideDelay, Delay=250}" AutomationProperties.Name="Délai avant le masquage du dock" />
                    </StackPanel>
                    <CheckBox Margin="28,14,0,0" IsChecked="{Binding DockShowNames}" Content="Afficher le nom du jeu au survol d'une jaquette" />
                    <CheckBox Margin="28,10,0,0" IsChecked="{Binding DockShowOptiGame}" Content="Afficher le raccourci vers OptiGame au bout du dock" />
                    <TextBlock Margin="28,6,0,0" Style="{StaticResource Text.Caption}"
                               Text="Limite : OptiGame fonctionnant en administrateur, Windows interdit d'y glisser un fichier depuis l'Explorateur ; l'ajout de jeux se fait depuis « Mes jeux »." />
                </StackPanel>
            </Border>

            <!-- Pendant les parties -->
            <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Pendant les parties" />
                    <CheckBox Margin="0,14,0,0" IsChecked="{Binding LightDuringGames}"
                              Content="Fermer la fenêtre et le dock d'OptiGame pendant les parties" />
                    <TextBlock Margin="28,6,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Text="Leur mémoire est libérée tant que vous jouez ; la fenêtre revient à la fin de la partie si elle était ouverte. OptiGame continue depuis la zone de notification : profil appliqué puis restauré, mesure automatique. Toujours, même décoché : jaquettes libérées, et le travail de fond (lecture des bibliothèques, téléchargement des jaquettes, notes) attend la fin de la partie." />
                </StackPanel>
            </Border>

            <!-- Note des jeux -->
            <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Note des jeux" />
                    <CheckBox Margin="0,14,0,0" IsChecked="{Binding AutoMeasureFps}"
                              Content="Mesurer automatiquement les FPS pendant les parties" />
                    <TextBlock Margin="28,6,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Text="Une seule mesure par partie : 1 minute avec PresentMon, après 4 minutes de jeu (menus et chargements passés). Elle donne la note mesurée des jeux, plus fiable que l'estimation tirée de la configuration requise. Les 5 dernières mesures de chaque jeu sont gardées (page « Mesures »). Nécessite PresentMon." />
                </StackPanel>
            </Border>

            <!-- Jaquettes IGDB -->
            <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Jaquettes (IGDB)" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Secondary}"
                               Text="Les jaquettes de « Mes jeux » viennent d'IGDB, la base de jeux de Twitch. Il faut une application développeur Twitch (gratuite, usage personnel) :" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Secondary}" LineHeight="22">
                        <Run Text="1. Ouvrez la console Twitch et connectez-vous (la double authentification doit être activée sur le compte)." /><LineBreak />
                        <Run Text="2. « Register Your Application » : un nom (ex. OptiGame), l'URL de redirection http://localhost, catégorie Application Integration, type Confidential." /><LineBreak />
                        <Run Text="3. Dans la liste des applications, cliquez « Manage » : copiez le Client ID, puis « New Secret » juste en dessous, et collez-les ci-dessous." /><LineBreak />
                        <Run Text="Pas de bouton « New Secret » ? L'application est de type « Public » : passez-la en « Confidential », ou recréez-la avec ce type." />
                    </TextBlock>
                    <Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Secondary}" Command="{Binding OpenTwitchConsoleCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Text="&#xE8A7;" />
                            <TextBlock Margin="8,0,0,0" Text="Ouvrir la console Twitch" />
                        </StackPanel>
                    </Button>

                    <TextBlock Style="{StaticResource Text.Label}" Text="Client ID" />
                    <TextBox Text="{Binding IgdbClientId, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" />
                    <TextBlock Style="{StaticResource Text.Label}" Text="Client Secret" />
                    <PasswordBox x:Name="SecretBox" PasswordChanged="OnSecretChanged" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Caption}"
                               Text="Un secret est enregistré (chiffré par Windows pour votre compte). Laissez le champ vide pour le conserver."
                               Visibility="{Binding HasIgdbSecret, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Primary}" Content="Enregistrer et tester" Command="{Binding TestIgdbCommand}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource Button.Ghost}" Content="Supprimer les identifiants" Command="{Binding ForgetIgdbCommand}" />
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Body}" Text="{Binding IgdbStatus}" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Caption}"
                               Text="Confidentialité : seul le nom de vos jeux est envoyé à IGDB/Twitch pour trouver les images. Les images sont gardées en cache sur ce PC." />
                </StackPanel>
            </Border>

            <!-- Dossiers de jeux -->
            <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Dossiers de jeux" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Secondary}"
                               Text="Utilisés par « Rechercher des jeux installés » (Mes jeux), en plus des bibliothèques Steam détectées automatiquement. Chaque sous-dossier est considéré comme un jeu." />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding GameFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4" Padding="12,8" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Control}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Retirer"
                                                Command="{Binding DataContext.RemoveGameFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" Text="{Binding}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Secondary}"
                            Content="Ajouter un dossier…" Command="{Binding AddGameFolderCommand}" />
                </StackPanel>
            </Border>

            <!-- Données -->
            <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Données" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Secondary}"
                               Text="Profils, sauvegardes de l'état d'origine (fixes.json, session.json), jaquettes, captures et journal sont enregistrés ici :" />
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Button.Secondary}"
                                Content="Ouvrir le dossier" Command="{Binding OpenDataFolderCommand}" />
                        <TextBox Text="{Binding DataFolder, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource Font.Mono}" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Caption}" Text="{Binding VersionText}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
