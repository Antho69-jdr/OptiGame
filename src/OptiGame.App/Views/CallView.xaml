<UserControl x:Class="OptiGame.App.Views.CallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OptiGame.App.ViewModels"
             xmlns:controls="clr-namespace:OptiGame.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CallViewModel}">
    <!-- Page « Amis » (CallViewModel) : appel en cours (onglets Appel / Périphériques / Son), appel entrant, demandes d'ami, puis la
         liste des amis (connexion avec Steam, en ligne avec « Appeler », hors ligne, ajout). Les réglages permanents de la voix sont
         dans Paramètres › Audio ; pendant un appel, les plus utiles sont repris ici. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="Amis" />
            <TextBlock Margin="0,4,0,16" Style="{StaticResource Text.Secondary}"
                       Text="Appelez vos amis pendant vos parties. La voix passe directement entre vos deux PC, chiffrée de bout en bout." />

            <controls:InfoBar Margin="{StaticResource Margin.StackL}" Severity="{Binding StatusSeverity}" Message="{Binding Status}"
                              Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource Button.Secondary}" Content="Paramètres du micro…" Command="{Binding OpenMicrophoneSettingsCommand}"
                        Visibility="{Binding CanOpenMicrophoneSettings, Converter={StaticResource BoolToVisibility}}" />
            </controls:InfoBar>

            <!-- ===== Appel entrant (aussi en petite fenêtre, Call/IncomingCallWindow) ===== -->
            <Border Margin="{StaticResource Margin.StackL}" Style="{StaticResource Card}"
                    Visibility="{Binding HasIncomingCall, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding IncomingCallText}" AutomationProperties.LiveSetting="Assertive" />
                    <WrapPanel Margin="0,12,0,0">
                        <controls:IconButton Margin="0,0,8,0" Style="{StaticResource Button.Primary}" Glyph="&#xE717;" Label="Répondre"
                                             Command="{Binding AnswerCallCommand}" />
                        <controls:IconButton Style="{StaticResource Button.DangerFilled}" Glyph="&#xE778;" Label="Refuser" Command="{Binding DeclineCallCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===== Demandes d'ami reçues ===== -->
            <ItemsControl ItemsSource="{Binding FriendRequests}" AutomationProperties.Name="Demandes d'ami">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="{StaticResource Margin.StackL}" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.BodyStrong}" TextWrapping="Wrap"
                                           Text="{Binding DisplayName, StringFormat={}{0} veut vous ajouter comme ami dans OptiGame}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}"
                                           Text="En acceptant, vous vous voyez en ligne et pouvez vous appeler, même sans être amis sur Steam. Ignorer ne prévient pas l'autre." />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Margin="0,0,8,0" Style="{StaticResource Button.Primary}" Content="Accepter" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.AcceptFriendRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <Button Style="{StaticResource Button.Secondary}" Content="Ignorer" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.IgnoreFriendRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Appel en cours (ou qui se prépare) ===== -->
            <Border Margin="{StaticResource Margin.StackL}" Style="{StaticResource Card}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding CallHeader}" AutomationProperties.LiveSetting="Polite" />

                    <!-- Avant la connexion : progression et « Annuler » -->
                    <StackPanel Visibility="{Binding IsInCall, Converter={StaticResource InverseBoolToVisibility}}">
                        <ProgressBar Margin="0,12,0,0" Height="4" IsIndeterminate="True" AutomationProperties.Name="{Binding CallHeader}" />
                        <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Secondary}" Content="Annuler"
                                Command="{Binding HangUpCommand}" />
                    </StackPanel>

                    <!-- Connecté : mots de contrôle, onglets, boutons -->
                    <StackPanel Visibility="{Binding IsInCall, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding ShowsSafetyWords, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="Mots de contrôle : " /><Run Text="{Binding SafetyWords, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" — votre ami doit voir les mêmes. Sinon, raccrochez." />
                        </TextBlock>
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}">
                            <Run Text="Connexion " /><Run Text="{Binding ConnectionPath, Mode=OneWay}" />
                        </TextBlock>

                        <Border Margin="0,12,0,0" HorizontalAlignment="Left" Padding="3" CornerRadius="{StaticResource Radius.Control}"
                                Background="{StaticResource Brush.Control}">
                            <WrapPanel>
                                <RadioButton Style="{StaticResource Segment}" GroupName="InCallTabs" IsChecked="{Binding IsCallTab}" Content="Appel" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="InCallTabs" IsChecked="{Binding IsDevicesTab}" Content="Périphériques" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="InCallTabs" IsChecked="{Binding IsSoundTab}" Content="Son" />
                            </WrapPanel>
                        </Border>

                        <!-- Onglet Appel : niveaux -->
                        <Grid Margin="0,16,0,0" Visibility="{Binding IsCallTab, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MaxWidth="360" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Margin="0,0,16,8" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="{Binding MicrophoneState}" />
                            <ProgressBar Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Height="6" VerticalAlignment="Center" Maximum="1" Value="{Binding LocalLevel, Mode=OneWay}"
                                         AutomationProperties.Name="Niveau de votre voix" />
                            <TextBlock Grid.Row="1" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="{Binding PeerState}" />
                            <ProgressBar Grid.Row="1" Grid.Column="1" Height="6" VerticalAlignment="Center" Maximum="1" Value="{Binding RemoteLevel, Mode=OneWay}"
                                         AutomationProperties.Name="Niveau de la voix de votre ami" />
                        </Grid>

                        <!-- Onglet Périphériques : micro, sortie, volume de l'ami -->
                        <StackPanel Margin="0,16,0,0" Visibility="{Binding IsDevicesTab, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel>
                                <StackPanel Margin="0,0,16,8">
                                    <Label Style="{StaticResource Text.FieldLabel}" Content="_Micro" Target="{Binding ElementName=MicBox}" />
                                    <ComboBox x:Name="MicBox" Width="320" ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}"
                                              AutomationProperties.Name="Micro" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,8">
                                    <Label Style="{StaticResource Text.FieldLabel}" Content="_Sortie audio" Target="{Binding ElementName=SpeakerBox}" />
                                    <ComboBox x:Name="SpeakerBox" Width="320" ItemsSource="{Binding Speakers}" SelectedItem="{Binding SelectedSpeaker}"
                                              AutomationProperties.Name="Sortie audio" />
                                </StackPanel>
                            </WrapPanel>
                            <Label Style="{StaticResource Text.FieldLabel}" Content="_Volume de votre ami" Target="{Binding ElementName=VolumeSlider}" />
                            <Slider x:Name="VolumeSlider" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                    Value="{Binding Volume}" AutomationProperties.Name="Volume de votre ami" />
                        </StackPanel>

                        <!-- Onglet Son : ce que vous envoyez -->
                        <StackPanel Margin="0,16,0,0" Visibility="{Binding IsSoundTab, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel>
                                <StackPanel Margin="0,0,16,8">
                                    <Label Style="{StaticResource Text.FieldLabel}" Content="_Qualité de la voix envoyée" Target="{Binding ElementName=QualityBox}" />
                                    <ComboBox x:Name="QualityBox" Width="320" ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality}"
                                              AutomationProperties.Name="Qualité de la voix envoyée" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,8">
                                    <Label Style="{StaticResource Text.FieldLabel}" Content="Suppression du _bruit" Target="{Binding ElementName=NoiseBox}" />
                                    <ComboBox x:Name="NoiseBox" Width="320" ItemsSource="{Binding NoiseOptions}" SelectedItem="{Binding SelectedNoise}"
                                              AutomationProperties.Name="Suppression du bruit" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,8">
                                    <Label Style="{StaticResource Text.FieldLabel}" Content="Seuil du mi_cro" Target="{Binding ElementName=GateBox}" />
                                    <ComboBox x:Name="GateBox" Width="320" ItemsSource="{Binding GateOptions}" SelectedItem="{Binding SelectedGate}"
                                              AutomationProperties.Name="Seuil du micro" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Margin="0,0,0,6" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text}" Text="{Binding AutoQualityText}"
                                       TextWrapping="Wrap" Visibility="{Binding HasAutoQualityText, Converter={StaticResource BoolToVisibility}}" />
                            <Grid Width="320" HorizontalAlignment="Left" Visibility="{Binding IsManualGate, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider VerticalAlignment="Center" Minimum="-80" Maximum="-10" SmallChange="1" LargeChange="5" Value="{Binding GateThreshold}"
                                        AutomationProperties.Name="Seuil du micro, en décibels" />
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}"
                                           Text="{Binding GateThreshold, StringFormat={}{0:0} dB}" />
                            </Grid>
                            <ProgressBar Width="320" Margin="0,10,0,0" HorizontalAlignment="Left" Height="8" Maximum="1" Value="{Binding MicMeter, Mode=OneWay}"
                                         AutomationProperties.Name="Niveau de votre micro" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="{Binding MeterText}" />
                        </StackPanel>

                        <WrapPanel Margin="0,16,0,0">
                            <controls:IconButton Margin="0,0,8,0" Style="{StaticResource Button.Primary}" Glyph="{Binding MuteGlyph}" Label="{Binding MuteLabel}"
                                                 Command="{Binding ToggleMuteCommand}" />
                            <controls:IconButton Style="{StaticResource Button.DangerFilled}" Glyph="&#xE778;" Label="Raccrocher" Command="{Binding HangUpCommand}" />
                        </WrapPanel>
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Caption}"
                                   Text="L'appel continue fenêtre fermée, même pendant une partie : micro et raccrocher aussi depuis l'icône d'OptiGame dans la zone de notification, et par votre raccourci (Paramètres › Audio)." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Liste des amis ===== -->
            <Border Style="{StaticResource Card}" DataContext="{Binding Friends}">
                <StackPanel>
                    <!-- Pas connecté avec Steam -->
                    <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Connectez-vous avec Steam" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="Pour voir vos amis Steam qui ont OptiGame ouvert et les appeler en un clic. La connexion se fait sur la page officielle de Steam, dans votre navigateur : OptiGame ne voit jamais votre mot de passe." />
                        <WrapPanel Margin="0,12,0,0">
                            <controls:IconButton Margin="0,0,8,0" Style="{StaticResource Button.Primary}" Glyph="&#xE77B;" Label="Se connecter avec Steam"
                                                 Command="{Binding DataContext.SignInSteamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Visibility="{Binding IsSigningIn, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}"
                                       Text="Terminez la connexion dans votre navigateur…" AutomationProperties.LiveSetting="Polite"
                                       Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource Button.Secondary}" Content="Annuler"
                                    Command="{Binding DataContext.CancelSteamSignInCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Connecté -->
                    <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding OnlineFriends.Count, StringFormat={}En ligne ({0})}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}">
                                    <Run Text="{Binding MyName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StateText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <controls:IconButton Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource Button.Secondary}" Glyph="&#xE8FA;" Label="Ajouter un ami…"
                                                 Command="{Binding DataContext.ToggleAddFriendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </Grid>

                        <!-- Ajouter un ami : personnes connues du client Steam -->
                        <Border Margin="0,12,0,0" Padding="12" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Control}"
                                Visibility="{Binding DataContext.IsAddingFriend, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Label Style="{StaticResource Text.FieldLabel}" Content="_Rechercher parmi les personnes que votre Steam connaît" Target="{Binding ElementName=FriendSearchBox}" />
                                <TextBox x:Name="FriendSearchBox" Width="320" HorizontalAlignment="Left"
                                         Text="{Binding DataContext.FriendSearch, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Rechercher un ami" />
                                <ItemsControl Margin="0,8,0,0" MaxHeight="260"
                                              ItemsSource="{Binding DataContext.FriendSearchResults, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1" Style="{StaticResource Button.SecondarySmall}" Content="Envoyer une demande" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.SendFriendRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='Envoyer une demande d’ami à {0}'}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Text="Ce sont les personnes que votre Steam a croisées (amis, groupes, discussions). La demande ne lui arrive que s'il a OptiGame ouvert et connecté à Steam ; il n'a qu'à accepter." />
                            </StackPanel>
                        </Border>

                        <!-- En ligne -->
                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding OnlineFriends}" AutomationProperties.Name="Amis en ligne">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.BodyStrong}" Text="{Binding Initial}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="{Binding DisplayName}" />
                                        <controls:IconButton Grid.Column="2" Style="{StaticResource Button.Primary}" Glyph="&#xE717;" Label="Appeler"
                                                             Command="{Binding DataContext.CallFriendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat=Appeler {0}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="Aucun de vos amis n'a OptiGame ouvert en ce moment."
                                   Visibility="{Binding ShowsNoFriends, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="Votre liste d'amis Steam est privée : seuls vos amis dont la liste est publique vous voient. Sans rien changer dans Steam, ajoutez vos amis ici : ils n'ont qu'à accepter."
                                   Visibility="{Binding ShowsPrivateListHint, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Hors ligne : amis OptiGame qui n'ont pas OptiGame ouvert -->
                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding DataContext.HasOfflineContacts, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Hors ligne" />
                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding DataContext.OfflineContacts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          AutomationProperties.Name="Amis hors ligne">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource Brush.Control}">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{Binding Initial}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}" Text="{Binding Name}" />
                                            <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Content="Retirer" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.RemoveContactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Retirer {0} de mes amis OptiGame}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsVisible}" Content="Visible de mes amis (ils peuvent m'appeler)" />
                            <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Content="Se déconnecter de Steam"
                                    Command="{Binding DataContext.SignOutSteamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </Grid>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Warning}" TextWrapping="Wrap"
                               Text="{Binding Message}" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
