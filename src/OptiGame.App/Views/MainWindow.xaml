<Window x:Class="OptiGame.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OptiGame.App.ViewModels"
        xmlns:views="clr-namespace:OptiGame.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding Title}" Height="860" Width="1240" MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Text}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Une page = un ViewModel ; la vue correspondante est choisie ici. -->
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}"><views:ProfilesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticViewModel}"><views:DiagnosticView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MeasuresViewModel}"><views:MeasuresView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barre latérale -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Brush.Accent}">
                        <TextBlock Text="OG" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Brush.OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="OptiGame"
                               FontFamily="{StaticResource Font.Display}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>

                <!-- Session en cours (rappel permanent) -->
                <Border DockPanel.Dock="Bottom" Padding="12" CornerRadius="{StaticResource Radius.Card}"
                        Background="{StaticResource Brush.AccentSoft}" DataContext="{Binding Session}"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0" Text="Session en cours" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,8" Style="{StaticResource Text.Caption}" Text="{Binding StatusText}" />
                        <Button Style="{StaticResource Button.SecondarySmall}" HorizontalAlignment="Stretch"
                                Content="Terminer et restaurer" Command="{Binding EndNowCommand}" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <RadioButton Style="{StaticResource NavButton}" GroupName="Navigation" IsChecked="{Binding IsSelected}"
                                         AutomationProperties.Name="{Binding Title}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding Glyph}" Width="22" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Title}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Contenu -->
        <DockPanel Grid.Column="1">
            <!-- Détection des jeux en panne : visible même si les notifications Windows sont masquées -->
            <Border DockPanel.Dock="Top" Margin="24,16,24,0" Style="{StaticResource Banner}"
                    Background="{StaticResource Brush.DangerSoft}" BorderBrush="{StaticResource Brush.Danger}"
                    DataContext="{Binding Session}"
                    Visibility="{Binding HasDetectionError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" Foreground="{StaticResource Brush.Danger}" />
                    <TextBlock Margin="10,0,0,0" Style="{StaticResource Text.Body}" Text="{Binding DetectionError}" />
                </StackPanel>
            </Border>

            <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
        </DockPanel>
    </Grid>
</Window>
