<Window x:Class="OptiGame.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OptiGame.App.ViewModels"
        xmlns:views="clr-namespace:OptiGame.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding Title}" Height="820" Width="1000" MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel>
        <!-- Détection des jeux en panne -->
        <Border DockPanel.Dock="Top" Margin="8,8,8,0" Padding="12,8" Background="#C62828" CornerRadius="4"
                DataContext="{Binding Session}"
                Visibility="{Binding HasDetectionError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Foreground="White" TextWrapping="Wrap" Text="{Binding DetectionError}" />
        </Border>

        <!-- Bandeau de session en cours -->
        <Border DockPanel.Dock="Top" Margin="8,8,8,0" Padding="12,8" Background="#1F7A4D" CornerRadius="4"
                DataContext="{Binding Session}"
                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Padding="12,4" Content="Terminer la session et restaurer" Command="{Binding EndNowCommand}" />
                <TextBlock VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Text="{Binding StatusText}" />
            </DockPanel>
        </Border>

        <TabControl Margin="8">
            <TabItem Header="Diagnostic">
                <views:DiagnosticView DataContext="{Binding Diagnostic}" />
            </TabItem>
            <TabItem Header="Profils de jeu">
                <views:ProfilesView DataContext="{Binding Profiles}" />
            </TabItem>
            <TabItem Header="Mesures">
                <views:MeasuresView DataContext="{Binding Measures}" />
            </TabItem>
            <TabItem Header="Paramètres">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
