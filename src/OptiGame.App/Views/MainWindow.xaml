<Window x:Class="OptiGame.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OptiGame.App.ViewModels"
        xmlns:views="clr-namespace:OptiGame.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding Title}" Height="720" Width="960" MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7">
    <TabControl Margin="8">
        <TabItem Header="Diagnostic">
            <views:DiagnosticView DataContext="{Binding Diagnostic}" />
        </TabItem>
        <TabItem Header="Profils de jeu">
            <views:ProfilesView DataContext="{Binding Profiles}" />
        </TabItem>
        <TabItem Header="Mesures">
            <TextBlock Margin="16" Text="Mesures PresentMon — phase 3." />
        </TabItem>
    </TabControl>
</Window>
