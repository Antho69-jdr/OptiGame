<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:OptiGame.App.Controls">
    <!--
        Système de design d'OptiGame (docs/design-system.md) : thème sombre Fluent (.NET 10, ThemeMode="Dark") + vert de la
        marque. Les contrôles standard (TextBox, ComboBox, CheckBox…) viennent du thème Fluent ; ce dictionnaire apporte les
        jetons (couleurs à rôle, typographie, espacements, rayons, focus) et les composants propres à l'appli.
        Règle : aucune couleur, taille de police ni rayon écrit en dur dans les vues ; tout passe par une clé d'ici.
    -->

    <!-- ===== Couleurs ===== -->
    <!-- Surfaces, de la plus profonde à la plus haute -->
    <Color x:Key="Color.Window">#0E1014</Color>
    <Color x:Key="Color.Sidebar">#12151B</Color>
    <Color x:Key="Color.Card">#181C23</Color>
    <Color x:Key="Color.CardHover">#1F242D</Color>
    <Color x:Key="Color.Control">#232833</Color>
    <Color x:Key="Color.ControlHover">#2B313D</Color>
    <Color x:Key="Color.ControlPressed">#1C2028</Color>
    <Color x:Key="Color.ControlSelected">#343B48</Color>
    <Color x:Key="Color.Border">#262C36</Color>
    <Color x:Key="Color.ControlBorder">#3A4250</Color>
    <!-- Textes : Text ≥ 11:1, TextSecondary ≥ 5,5:1, TextMuted ≥ 4,5:1 sur toutes les surfaces sauf ControlSelected -->
    <Color x:Key="Color.Text">#EDEFF3</Color>
    <Color x:Key="Color.TextSecondary">#A2A9B4</Color>
    <Color x:Key="Color.TextMuted">#9099A6</Color>
    <Color x:Key="Color.TextDisabled">#6B7280</Color>
    <!-- Marque = action principale = sélection (jamais un statut ni une décoration) -->
    <Color x:Key="Color.Accent">#2FD27A</Color>
    <Color x:Key="Color.AccentHover">#4BE391</Color>
    <Color x:Key="Color.AccentPressed">#22B566</Color>
    <Color x:Key="Color.OnAccent">#06140C</Color>
    <Color x:Key="Color.AccentLight3">#98F2C1</Color>
    <Color x:Key="Color.AccentText">#6FEBA8</Color>
    <Color x:Key="Color.AccentDark2">#198F50</Color>
    <Color x:Key="Color.AccentDark3">#11693A</Color>
    <Color x:Key="Color.OnAccentSecondary">#1A3A28</Color>
    <!-- Statuts (couleurs système Fluent sombre) : toujours accompagnés d'une icône de forme et d'un mot -->
    <Color x:Key="Color.Ok">#6CCB5F</Color>
    <Color x:Key="Color.Warning">#FCE100</Color>
    <Color x:Key="Color.Danger">#FF99A4</Color>
    <Color x:Key="Color.OnDanger">#2A0A10</Color>
    <Color x:Key="Color.Info">#60CDFF</Color>
    <!-- Séries des graphes : bleu / orange, distinguables par les daltoniens et sans sens de statut -->
    <Color x:Key="Color.Series1">#60CDFF</Color>
    <Color x:Key="Color.Series2">#FF9F43</Color>
    <Color x:Key="Color.FocusRing">#FFFFFF</Color>
    <!-- Dock : plateau (son opacité vient des paramètres) et onde du clic -->
    <Color x:Key="Color.DockPlate">#121620</Color>
    <Color x:Key="Color.Highlight">#FFFFFF</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" />
    <SolidColorBrush x:Key="Brush.CardHover" Color="{StaticResource Color.CardHover}" />
    <SolidColorBrush x:Key="Brush.Control" Color="{StaticResource Color.Control}" />
    <SolidColorBrush x:Key="Brush.ControlHover" Color="{StaticResource Color.ControlHover}" />
    <SolidColorBrush x:Key="Brush.ControlPressed" Color="{StaticResource Color.ControlPressed}" />
    <SolidColorBrush x:Key="Brush.ControlSelected" Color="{StaticResource Color.ControlSelected}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="{StaticResource Color.ControlBorder}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Ok" Color="{StaticResource Color.Ok}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.OnDanger" Color="{StaticResource Color.OnDanger}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />
    <!-- Fonds « doux » des statuts (InfoBar, badges) : texte ≥ 10:1, couleur du statut ≥ 6,4:1 -->
    <SolidColorBrush x:Key="Brush.OkSoft" Color="{StaticResource Color.Ok}" Opacity="0.14" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource Color.Warning}" Opacity="0.14" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.Danger}" Opacity="0.14" />
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="{StaticResource Color.Info}" Opacity="0.14" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.Accent}" Opacity="0.12" />
    <SolidColorBrush x:Key="Brush.NeutralSoft" Color="{StaticResource Color.Text}" Opacity="0.08" />
    <SolidColorBrush x:Key="Brush.Series1" Color="{StaticResource Color.Series1}" />
    <SolidColorBrush x:Key="Brush.Series2" Color="{StaticResource Color.Series2}" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="{StaticResource Color.FocusRing}" />
    <!-- Voiles posés sur les images (jaquettes, bannière) : pastilles et petits boutons ronds lisibles sur toute image -->
    <SolidColorBrush x:Key="Brush.Scrim" Color="#CC0E1014" />
    <SolidColorBrush x:Key="Brush.ScrimStrong" Color="#E60E1014" />
    <SolidColorBrush x:Key="Brush.ScrimLight" Color="#990E1014" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#F0181C23" />
    <SolidColorBrush x:Key="Brush.OverlayBorder" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Brush.CoverButton" Color="#CC0E1014" />
    <SolidColorBrush x:Key="Brush.CoverButtonHover" Color="#F0181C23" />
    <SolidColorBrush x:Key="Brush.CoverButtonBorder" Color="#33FFFFFF" />
    <!-- Remplaçants d'image (jeu sans jaquette, sans bannière) -->
    <LinearGradientBrush x:Key="Brush.CoverPlaceholder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#243040" Offset="0" />
        <GradientStop Color="#151A22" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.CoverPlaceholderMuted" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1B222D" Offset="0" />
        <GradientStop Color="#12161D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.BannerPlaceholder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1D2633" Offset="0" />
        <GradientStop Color="#0E1014" Offset="1" />
    </LinearGradientBrush>
    <!-- Fondu de la bannière vers le fond de la fenêtre, pour la lisibilité du titre -->
    <LinearGradientBrush x:Key="Brush.BannerFade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#330E1014" Offset="0" />
        <GradientStop Color="#990E1014" Offset="0.55" />
        <GradientStop Color="#FF0E1014" Offset="1" />
    </LinearGradientBrush>
    <!-- Dock -->
    <SolidColorBrush x:Key="Brush.DockPlate" Color="#E6121620" />
    <SolidColorBrush x:Key="Brush.DockBorder" Color="#40FFFFFF" />
    <LinearGradientBrush x:Key="Brush.DockPlaceholder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2A3646" Offset="0" />
        <GradientStop Color="#171C25" Offset="1" />
    </LinearGradientBrush>
    <!-- Alpha 1 : invisible mais reçoit la souris (bande de déclenchement du dock). Jamais 0 : les clics la traverseraient. -->
    <SolidColorBrush x:Key="Brush.HitTestOnly" Color="#01000000" />

    <!-- ===== Typographie (échelle 12 · 14 · 16 · 20 · 28 · 40) ===== -->
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">16</sys:Double>
    <sys:Double x:Key="FontSize.Title">20</sys:Double>
    <sys:Double x:Key="FontSize.PageTitle">28</sys:Double>
    <sys:Double x:Key="FontSize.Hero">40</sys:Double>
    <sys:Double x:Key="IconSize.Small">12</sys:Double>
    <sys:Double x:Key="IconSize.Body">16</sys:Double>
    <sys:Double x:Key="IconSize.Large">20</sys:Double>
    <sys:Double x:Key="IconSize.Hero">28</sys:Double>

    <!-- ===== Espacements (grille de 4) et rayons ===== -->
    <sys:Double x:Key="Space.XS">4</sys:Double>
    <sys:Double x:Key="Space.S">8</sys:Double>
    <sys:Double x:Key="Space.M">12</sys:Double>
    <sys:Double x:Key="Space.L">16</sys:Double>
    <sys:Double x:Key="Space.XL">24</sys:Double>
    <sys:Double x:Key="Space.XXL">32</sys:Double>
    <Thickness x:Key="Padding.Page">32,24,32,32</Thickness>
    <Thickness x:Key="Padding.Card">20</Thickness>
    <Thickness x:Key="Padding.CardCompact">16,12</Thickness>
    <Thickness x:Key="Padding.Dialog">24</Thickness>
    <Thickness x:Key="Margin.StackXS">0,0,0,4</Thickness>
    <Thickness x:Key="Margin.StackS">0,0,0,8</Thickness>
    <Thickness x:Key="Margin.StackM">0,0,0,12</Thickness>
    <Thickness x:Key="Margin.StackL">0,0,0,16</Thickness>
    <Thickness x:Key="Margin.StackXL">0,0,0,24</Thickness>
    <Thickness x:Key="Margin.InlineS">0,0,8,0</Thickness>
    <Thickness x:Key="Margin.InlineM">0,0,12,0</Thickness>
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.CardTop">8,8,0,0</CornerRadius>
    <CornerRadius x:Key="Radius.Cover">8</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">12</CornerRadius>
    <CornerRadius x:Key="Radius.Round">999</CornerRadius>

    <!-- ===== Logo (Assets/OptiGame.svg, case 64×64) : cadran ouvert en « O » + triangle « lecture » ===== -->
    <Geometry x:Key="Logo.Dial">M22.5,48.5 A19,19 0 1 1 41.5,48.5</Geometry>
    <Geometry x:Key="Logo.Play">M27,23 L27,41 L42,32 Z</Geometry>
    <Pen x:Key="Logo.DialPen" Brush="{StaticResource Brush.OnAccent}" Thickness="6" StartLineCap="Round" EndLineCap="Round" />
    <Pen x:Key="Logo.PlayPen" Brush="{StaticResource Brush.OnAccent}" Thickness="3" LineJoin="Round" />
    <!-- Logo.Image = tuile verte entière (barre latérale) ; Logo.Mark = symbole seul, à poser sur Brush.Accent (dock) -->
    <DrawingImage x:Key="Logo.Image">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Brush.Accent}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="{StaticResource Logo.Dial}" Pen="{StaticResource Logo.DialPen}" />
                <GeometryDrawing Geometry="{StaticResource Logo.Play}" Brush="{StaticResource Brush.OnAccent}" Pen="{StaticResource Logo.PlayPen}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Logo.Mark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H64 V64 H0 Z" />
                <GeometryDrawing Geometry="{StaticResource Logo.Dial}" Pen="{StaticResource Logo.DialPen}" />
                <GeometryDrawing Geometry="{StaticResource Logo.Play}" Brush="{StaticResource Brush.OnAccent}" Pen="{StaticResource Logo.PlayPen}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ===== Focus clavier : anneau blanc de 2 px, à 3 px du contrôle (affiché au clavier seulement) ===== -->
    <Style x:Key="Focus.Ring">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{StaticResource Brush.FocusRing}" BorderThickness="2" CornerRadius="7"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Grandes surfaces (cartes, jaquettes) -->
    <Style x:Key="Focus.RingCard">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{StaticResource Brush.FocusRing}" BorderThickness="2" CornerRadius="11"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- À l'intérieur du contrôle (éléments collés à un bord qui couperait l'anneau extérieur) -->
    <Style x:Key="Focus.RingInset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{StaticResource Brush.FocusRing}" BorderThickness="2" CornerRadius="4" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Textes ===== -->
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <!-- Titre de section ou de carte (niveau 2 ou 3 selon la page) -->
    <Style x:Key="Text.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>
    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.SectionTitle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
    </Style>
    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.PageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="Text.Hero" TargetType="TextBlock" BasedOn="{StaticResource Text.PageTitle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Hero}" />
    </Style>
    <!-- Chiffre clé (FPS, note, temps de jeu) : jamais en couleur d'accent, c'est une valeur -->
    <Style x:Key="Text.Stat" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.PageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>
    <!-- Libellé de champ (marge intégrée héritée ; nouveaux écrans : Text.FieldLabel, sans marge) -->
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style x:Key="Text.FieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="{StaticResource Margin.StackS}" />
    </Style>
    <Style x:Key="Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Ligne de statut neutre (le succès ou l'échec passe par une InfoBar) ; ne prend aucune place quand elle est vide -->
    <Style x:Key="Text.Status" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Glyphe Segoe Fluent Icons. Décoratif : le sens est toujours porté par un texte ou un nom accessible voisin. -->
    <Style x:Key="Text.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="{StaticResource IconSize.Body}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Surfaces ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
    </Style>
    <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="{StaticResource Padding.CardCompact}" />
    </Style>
    <!-- Ancienne coquille de bandeau : remplacée par controls:InfoBar au fil de la refonte -->
    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ===== Boutons : un gabarit commun, décliné en variantes ===== -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}"
                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,5,12,6" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Action principale de l'écran : une seule visible à la fois -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.AccentHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.AccentPressed}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Action principale mise en avant (Jouer) -->
    <Style x:Key="Button.PrimaryLarge" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="20,7,20,8" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Subtitle}" />
    </Style>

    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Control}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.ControlHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.ControlPressed}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Action discrète (sans fond) -->
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.ControlHover}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.ControlPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Action destructrice, secondaire (Retirer, Supprimer…) -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.ControlPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Action destructrice confirmée (bouton d'un dialogue de confirmation) -->
    <Style x:Key="Button.DangerFilled" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnDanger}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Petits boutons (listes, lignes de réglage) : 28 px, au-dessus de la cible minimale de 24 px -->
    <Style x:Key="Button.SecondarySmall" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,3,10,4" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Bouton icône seule (32 × 32) : nom accessible et infobulle = libellé (controls:IconButton) -->
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>

    <!-- ===== Sélecteur à segments : sélection = fond + texte + trait d'accent (jamais la teinte seule) ===== -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bg" Padding="16,6,16,7" CornerRadius="{StaticResource Radius.Small}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Pill" Width="16" Height="3" Margin="0,0,0,2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                CornerRadius="2" Background="{StaticResource Brush.Selection}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.ControlSelected}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Ligne repliable : en-tête (icône, titre, résumé d'une ligne, chevron), contenu détaillé dessous ===== -->
    <Style x:Key="Expander.Row" TargetType="Expander">
        <Setter Property="Margin" Value="{StaticResource Margin.StackS}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Card}">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Content="{TemplateBinding Header}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          FocusVisualStyle="{StaticResource Focus.RingCard}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bg" Padding="18,13" Background="Transparent" CornerRadius="{StaticResource Radius.Card}">
                                            <DockPanel>
                                                <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Margin="14,0,0,0" Style="{StaticResource Text.Icon}"
                                                           FontSize="{StaticResource IconSize.Small}" Foreground="{StaticResource Brush.TextSecondary}" Text="&#xE70D;" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.CardHover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                                                <Setter TargetName="Bg" Property="CornerRadius" Value="{StaticResource Radius.CardTop}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="Body" Padding="18,4,18,18" Visibility="Collapsed">
                                <ContentPresenter />
                            </Border>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Navigation latérale : RadioButton = un seul élément actif, trait d'accent = forme de la sélection ===== -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}"
                                Padding="12,9">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Indicator" Width="3" Height="16" HorizontalAlignment="Left" CornerRadius="2"
                                Background="{StaticResource Brush.Selection}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.CardHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Control}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Badges (pastilles) : toujours un mot, éventuellement une icône ; la gravité n'est jamais la couleur seule ===== -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Padding" Value="8,2,8,3" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Badge.Neutral" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource Brush.NeutralSoft}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Badge.Success" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource Brush.OkSoft}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Ok}" />
    </Style>
    <Style x:Key="Badge.Warning" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource Brush.WarningSoft}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Warning}" />
    </Style>
    <Style x:Key="Badge.Danger" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Danger}" />
    </Style>
    <Style x:Key="Badge.Info" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource Brush.InfoSoft}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Info}" />
    </Style>
    <!-- Posé sur une image (jaquette) -->
    <Style x:Key="Badge.Overlay" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource Brush.ScrimStrong}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Text}" />
    </Style>

    <!-- ===== InfoBar (modèle WinUI) : gravité = fond + icône de forme + nom accessible ; annoncée aux lecteurs d'écran ===== -->
    <Style TargetType="controls:InfoBar">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{StaticResource Brush.InfoSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:InfoBar">
                    <Border Background="{StaticResource Brush.Card}" CornerRadius="{StaticResource Radius.Card}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Card}" Padding="14,10,8,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Icon" Margin="0,2,12,0" VerticalAlignment="Top" Style="{StaticResource Text.Icon}"
                                           FontSize="{StaticResource IconSize.Body}" Foreground="{StaticResource Brush.Info}" Text="&#xE946;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock x:Name="TitleText" Style="{StaticResource Text.BodyStrong}" Text="{TemplateBinding Title}" />
                                    <TextBlock x:Name="MessageText" Style="{StaticResource Text.Body}" Text="{TemplateBinding Message}" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <controls:IconButton x:Name="CloseButton" Grid.Column="3" VerticalAlignment="Top" Style="{StaticResource Button.Icon}"
                                                     Glyph="&#xE711;" Label="{TemplateBinding CloseLabel}" IsLabelVisible="False"
                                                     Command="{TemplateBinding CloseCommand}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Message" Value="">
                            <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Message" Value="{x:Null}">
                            <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsClosable" Value="True">
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Success">
                            <Setter Property="Background" Value="{StaticResource Brush.OkSoft}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Brush.Ok}" />
                            <Setter TargetName="Icon" Property="Text" Value="&#xE930;" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter Property="Background" Value="{StaticResource Brush.WarningSoft}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Brush.Warning}" />
                            <Setter TargetName="Icon" Property="Text" Value="&#xE7BA;" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
                            <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Brush.Danger}" />
                            <Setter TargetName="Icon" Property="Text" Value="&#xEA39;" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
