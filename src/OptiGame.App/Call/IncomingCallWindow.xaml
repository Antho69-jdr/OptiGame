<Window x:Class="OptiGame.App.Call.IncomingCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OptiGame.App.Controls"
        Title="OptiGame — Appel entrant" Width="340" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" Background="{StaticResource Brush.Card}"
        BorderBrush="{StaticResource Brush.ControlBorder}" BorderThickness="1">
    <!-- Appel d'un ami Steam (Call/IncomingCallPresenter) : en bas à droite de l'écran principal, au premier plan sans prendre le
         clavier au jeu. DataContext = CallViewModel. -->
    <Border Padding="16">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Label}" Text="Appel entrant · OptiGame" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.SectionTitle}" Text="{Binding IncomingCallText}" TextWrapping="Wrap" />
            <WrapPanel Margin="0,12,0,0">
                <controls:IconButton Margin="0,0,8,0" Style="{StaticResource Button.Primary}" Glyph="&#xE717;" Label="Répondre"
                                     Command="{Binding AnswerCallCommand}" />
                <controls:IconButton Style="{StaticResource Button.DangerFilled}" Glyph="&#xE778;" Label="Refuser" Command="{Binding DeclineCallCommand}" />
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
