<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icône de l'exe, reprise d'office par toutes les fenêtres (WPF prend celle de l'exe quand Window.Icon n'est pas posé). -->
    <ApplicationIcon>Assets\OptiGame.ico</ApplicationIcon>
    <!-- Ressources traduites des bibliothèques (WPF…) : le français seulement, l'appli est en français (publication plus légère). -->
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <!-- Pas de fichiers .xml de documentation des bibliothèques dans la publication (WebView2…). -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AssemblyName>OptiGame</AssemblyName>
    <RootNamespace>OptiGame.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logo de la zone de notification (App.LoadTrayIcon). Sources : Assets/OptiGame.svg et OptiGame-small.svg. -->
    <Resource Include="Assets\OptiGame.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Page de l'appel vocal (Call/CallEngine), servie depuis le dossier de l'appli (Program Files : modifiable par un admin seulement). -->
    <Content Include="Call\call.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptiGame.Core\OptiGame.Core.csproj" />
    <ProjectReference Include="..\OptiGame.Platform\OptiGame.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <!-- Lecteur des bandes-annonces (Controls/TrailerPlayer) : moteur web de Windows, créé au clic seulement. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

</Project>
