<Application x:Class="OptiGame.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="OptiGame"
                        NoLeftClickDelay="True"
                        LeftClickCommand="{Binding ShowMainWindowCommand}">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="OG" Foreground="White" Background="#1F7A4D" FontWeight="Bold" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Ouvrir OptiGame" Command="{Binding ShowMainWindowCommand}" FontWeight="Bold" />
                    <Separator />
                    <MenuItem Header="Quitter" Command="{Binding ExitCommand}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
