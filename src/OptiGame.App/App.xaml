<Application x:Class="OptiGame.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             xmlns:conv="clr-namespace:OptiGame.App.Converters"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Accent du thème Fluent (cases cochées, curseurs, sélection de texte…) aligné sur le vert d'OptiGame.
                Déclaré ici et non dans Theme.xaml : les ressources directes de l'application priment sur tous les
                dictionnaires fusionnés, dont celui du thème Fluent. Noms relevés dans PresentationFramework.Fluent.dll (10.0.9).
                Brosses = couleurs Color.Accent* de Themes/Theme.xaml. Les 8 valeurs Color ci-dessous RECOPIENT ces couleurs :
                un alias StaticResource n'est pas accepté ici par le compilateur XAML (erreur MC2000) ; les garder identiques.
            -->
            <Color x:Key="AccentColor">#2FD27A</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource Color.Accent}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource Color.Accent}" Opacity="0.9" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource Color.Accent}" Opacity="0.8" />
            <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource Color.Accent}" />
            <SolidColorBrush x:Key="AccentDefaultBrush" Color="{StaticResource Color.Accent}" />
            <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource Color.Accent}" Opacity="0.9" />
            <SolidColorBrush x:Key="AccentTertiaryBrush" Color="{StaticResource Color.Accent}" Opacity="0.8" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="{StaticResource Color.AccentPressed}" />
            <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="{StaticResource Color.AccentPressed}" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource Color.AccentText}" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource Color.AccentLight3}" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource Color.AccentHover}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource Color.OnAccent}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource Color.OnAccentSecondary}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="{StaticResource Color.OnAccent}" />
            <!-- Clés système d'accent (.NET 9+), alimentées par Windows et utilisées par les modèles Fluent -->
            <Color x:Key="{x:Static SystemColors.AccentColorKey}">#2FD27A</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorLight1Key}">#4BE391</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorLight2Key}">#2FD27A</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorLight3Key}">#98F2C1</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorDark1Key}">#22B566</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorDark2Key}">#198F50</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorDark3Key}">#11693A</Color>
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorBrushKey}" Color="{StaticResource Color.Accent}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorLight1BrushKey}" Color="{StaticResource Color.AccentHover}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorLight2BrushKey}" Color="{StaticResource Color.Accent}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorLight3BrushKey}" Color="{StaticResource Color.AccentLight3}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorDark1BrushKey}" Color="{StaticResource Color.AccentPressed}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorDark2BrushKey}" Color="{StaticResource Color.AccentDark2}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorDark3BrushKey}" Color="{StaticResource Color.AccentDark3}" />

            <BooleanToVisibilityConverter x:Key="TrayBoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:EmptyAndUnfocusedToVisibilityConverter x:Key="EmptyAndUnfocusedToVisibility" />
            <tb:TaskbarIcon x:Key="TrayIcon"
                            ToolTipText="{Binding Session.TrayToolTip}"
                            NoLeftClickDelay="True"
                            LeftClickCommand="{Binding ShowMainWindowCommand}">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Ouvrir OptiGame" Command="{Binding ShowMainWindowCommand}" FontWeight="Bold" />
                        <Separator />
                        <MenuItem Header="{Binding Session.StatusText}" IsEnabled="False"
                                  Visibility="{Binding Session.IsActive, Converter={StaticResource TrayBoolToVisibility}}" />
                        <MenuItem Header="Terminer la session et restaurer les réglages" Command="{Binding Session.EndNowCommand}"
                                  Visibility="{Binding Session.IsActive, Converter={StaticResource TrayBoolToVisibility}}" />
                        <Separator Visibility="{Binding Session.IsActive, Converter={StaticResource TrayBoolToVisibility}}" />
                        <MenuItem Header="Quitter" Command="{Binding ExitCommand}" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
