<dialogs:DialogWindow x:Class="OptiGame.App.Dialogs.ConfirmChangeDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="clr-namespace:OptiGame.App.Dialogs"
                      xmlns:controls="clr-namespace:OptiGame.App.Controls"
                      Title="Confirmer l'optimisation" Width="580">
    <controls:DialogLayout x:Name="Layout">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Pourquoi" />
            <TextBlock x:Name="WhyText" Margin="0,4,0,0" Style="{StaticResource Text.Body}" />

            <controls:InfoBar x:Name="WarningBar" Margin="0,16,0,0" Severity="Warning" Title="À savoir avant d'appliquer" />

            <controls:RequirementBadges x:Name="Requirements" Margin="0,16,0,0" />
            <TextBlock x:Name="UndoText" Margin="0,8,0,0" Style="{StaticResource Text.Secondary}" />

            <!-- Ce que l'optimisation écrit exactement (registre, réglage du pilote…) -->
            <Expander Margin="0,16,0,0" Style="{StaticResource Expander.Disclosure}" Header="Détails techniques">
                <TextBlock x:Name="WhatText" Margin="0,8,0,0" Style="{StaticResource Text.Mono}" />
            </Expander>

            <!-- Option avancée : double confirmation -->
            <CheckBox x:Name="AcknowledgeBox" Margin="0,20,0,0" Checked="OnAcknowledgeChanged" Unchecked="OnAcknowledgeChanged">
                <TextBlock TextWrapping="Wrap" Text="J'ai lu l'avertissement et je comprends le compromis." />
            </CheckBox>
        </StackPanel>
        <controls:DialogLayout.Footer>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ApplyButton" Margin="0,0,8,0" Style="{StaticResource Button.Primary}" Content="Appliquer" Click="OnApply" />
                <Button x:Name="CancelButton" Style="{StaticResource Button.Secondary}" Content="Annuler" IsCancel="True" IsDefault="True" />
            </StackPanel>
        </controls:DialogLayout.Footer>
    </controls:DialogLayout>
</dialogs:DialogWindow>
