<Window x:Class="OptiGame.App.Dialogs.ConfirmChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmer la modification" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

        <TextBlock Margin="0,14,0,2" FontWeight="SemiBold" Text="Ce qui change" />
        <TextBlock x:Name="WhatText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />

        <TextBlock Margin="0,12,0,2" FontWeight="SemiBold" Text="Pourquoi" />
        <TextBlock x:Name="WhyText" TextWrapping="Wrap" />

        <Border x:Name="WarningPanel" Margin="0,12,0,0" Padding="10" Background="#FFF3E0" BorderBrush="#E65100"
                BorderThickness="1" CornerRadius="4">
            <TextBlock x:Name="WarningText" TextWrapping="Wrap" />
        </Border>

        <StackPanel Margin="0,12,0,0">
            <TextBlock x:Name="AdminText" Text="• Nécessite les droits administrateur." />
            <TextBlock x:Name="RebootText" Text="• Pris en compte après un redémarrage de Windows." />
            <TextBlock Text="• L'état d'origine est sauvegardé avant la modification ; vous pourrez l'annuler depuis l'onglet Diagnostic." />
        </StackPanel>

        <CheckBox x:Name="AcknowledgeBox" Margin="0,14,0,0" Checked="OnAcknowledgeChanged" Unchecked="OnAcknowledgeChanged">
            <TextBlock TextWrapping="Wrap" Text="J'ai lu l'avertissement et je comprends le compromis." />
        </CheckBox>

        <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ApplyButton" Content="Appliquer" Padding="16,6" Margin="0,0,8,0" Click="OnApply" />
            <Button Content="Annuler" Padding="16,6" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
