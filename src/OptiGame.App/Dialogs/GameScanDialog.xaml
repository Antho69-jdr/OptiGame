<dialogs:DialogWindow x:Class="OptiGame.App.Dialogs.GameScanDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="clr-namespace:OptiGame.App.Dialogs"
                      xmlns:controls="clr-namespace:OptiGame.App.Controls"
                      Title="Jeux installés" Width="760" Height="620" MinWidth="520" MinHeight="360"
                      ResizeMode="CanResize" SizeToContent="Manual">
    <controls:DialogLayout x:Name="Layout" Heading="Ajouter des jeux installés" IsBodyScrollable="False"
                           Description="Cochez les jeux à ajouter à Mes jeux. Le fichier .exe proposé est le plus probable : changez-le si besoin (celui du jeu, pas de son lanceur). Rien n'est modifié tant que vous ne réglez pas un jeu.">
        <DockPanel>
            <TextBlock x:Name="FoldersHint" DockPanel.Dock="Top" Margin="0,0,0,12" Style="{StaticResource Text.Caption}" />
            <!-- Ligne = case (clic, Espace), flèches pour se déplacer ; Tab passe aussi par le choix de l'exe de chaque jeu -->
            <ListBox x:Name="List" Style="{StaticResource CheckList}" ItemContainerStyle="{StaticResource CheckList.Item}"
                     KeyboardNavigation.TabNavigation="Continue" SelectionChanged="OnSelectionChanged"
                     AutomationProperties.Name="Jeux installés détectés">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding Suffix, Mode=OneWay}" Foreground="{StaticResource Brush.TextSecondary}" />
                            </TextBlock>
                            <ComboBox Margin="0,6,0,0" HorizontalAlignment="Left" MinWidth="320" ItemsSource="{Binding Candidates}"
                                      SelectedItem="{Binding SelectedExe}" DisplayMemberPath="Label"
                                      AutomationProperties.Name="{Binding Name, StringFormat='Fichier .exe de {0}'}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <controls:DialogLayout.Footer>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SelectAllButton" Margin="0,0,24,0" Style="{StaticResource Button.Ghost}" Click="OnSelectAll" />
                <Button x:Name="AddButton" Margin="0,0,8,0" Style="{StaticResource Button.Primary}" IsEnabled="False" Click="OnOk" />
                <Button Style="{StaticResource Button.Secondary}" Content="Annuler" IsCancel="True" />
            </StackPanel>
        </controls:DialogLayout.Footer>
    </controls:DialogLayout>
</dialogs:DialogWindow>
