<dialogs:DialogWindow x:Class="OptiGame.App.Dialogs.BackgroundPickerDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="clr-namespace:OptiGame.App.Dialogs"
                      xmlns:controls="clr-namespace:OptiGame.App.Controls"
                      xmlns:conv="clr-namespace:OptiGame.App.Converters"
                      Title="Changer le fond" Width="900" Height="660" MinWidth="600" MinHeight="420"
                      ResizeMode="CanResize" SizeToContent="Manual">
    <Window.Resources>
        <conv:PathToImageConverter x:Key="PathToImage" />
    </Window.Resources>
    <controls:DialogLayout x:Name="Layout" Heading="Changer le fond" IsBodyScrollable="False">
        <DockPanel>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="0,0,0,10" Style="{StaticResource Text.Caption}"
                       AutomationProperties.LiveSetting="Polite" />
            <ListBox x:Name="Options" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnDoubleClick" ItemContainerStyle="{StaticResource ListItem.Selectable}"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Fonds proposés">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="256" Margin="4">
                            <Border Height="144" CornerRadius="{StaticResource Radius.Cover}" Background="{StaticResource Brush.CoverPlaceholderMuted}">
                                <Grid>
                                    <TextBlock Margin="8" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                               Style="{StaticResource Text.Caption}" Text="{Binding PreviewText}" />
                                    <Border CornerRadius="{StaticResource Radius.Cover}">
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill" ImageSource="{Binding ThumbPath, Converter={StaticResource PathToImage}, ConverterParameter=512}" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Label}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <controls:DialogLayout.Footer>
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Content="Choisir une image sur le PC…" Click="OnBrowse" />
                    <Button x:Name="OriginalButton" Style="{StaticResource Button.Ghost}" Content="Revenir au fond d'origine" Click="OnOriginal"
                            Visibility="Collapsed" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="UseButton" Margin="0,0,8,0" Style="{StaticResource Button.Primary}" Content="Utiliser ce fond"
                            IsEnabled="False" IsDefault="True" Click="OnUse" />
                    <Button Style="{StaticResource Button.Secondary}" Content="Annuler" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </controls:DialogLayout.Footer>
    </controls:DialogLayout>
</dialogs:DialogWindow>
