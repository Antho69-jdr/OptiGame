<Window x:Class="OptiGame.App.Dialogs.DriverInstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmer l'installation" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Text}">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" Style="{StaticResource Text.SectionTitle}" FontSize="18" />

        <TextBlock Style="{StaticResource Text.Label}" Text="Ce qui sera installé" />
        <Border Padding="12,8" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Control}">
            <TextBlock x:Name="WhatText" Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap" />
        </Border>

        <TextBlock Style="{StaticResource Text.Label}" Text="Pourquoi" />
        <TextBlock x:Name="WhyText" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />

        <!-- Exception au principe de réversibilité : dite clairement, avec le chemin du retour en arrière -->
        <Border Margin="0,16,0,0" Style="{StaticResource Banner}"
                Background="{StaticResource Brush.WarningSoft}" BorderBrush="{StaticResource Brush.Warning}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Margin="0,0,10,0" Style="{StaticResource Text.Icon}" VerticalAlignment="Top"
                           Foreground="{StaticResource Brush.Warning}" Text="&#xE7BA;" />
                <StackPanel>
                    <TextBlock x:Name="NotReversibleText" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="RollbackText" Margin="0,6,0,0" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Margin="0,16,0,0">
            <TextBlock Style="{StaticResource Text.Secondary}" Text="• Nécessite les droits administrateur." />
            <TextBlock x:Name="RebootText" Style="{StaticResource Text.Secondary}" Text="• Un redémarrage de Windows peut être demandé." />
        </StackPanel>

        <CheckBox x:Name="RestorePointBox" Margin="0,16,0,0" IsChecked="True">
            <TextBlock x:Name="RestorePointLabel" TextWrapping="Wrap" />
        </CheckBox>
        <TextBlock x:Name="RestorePointDisabledText" Margin="0,16,0,0" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />

        <CheckBox x:Name="AcknowledgeBox" Margin="0,16,0,0" Checked="OnAcknowledgeChanged" Unchecked="OnAcknowledgeChanged">
            <TextBlock TextWrapping="Wrap" Text="Je comprends qu'OptiGame ne pourra pas annuler cette installation." />
        </CheckBox>

        <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="InstallButton" Style="{StaticResource Button.Primary}" Content="Installer" Margin="0,0,8,0" IsEnabled="False" Click="OnInstall" />
            <Button Style="{StaticResource Button.Secondary}" Content="Annuler" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
