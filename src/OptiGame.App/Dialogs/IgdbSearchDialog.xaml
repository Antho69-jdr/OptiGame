<Window x:Class="OptiGame.App.Dialogs.IgdbSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:OptiGame.App.Converters"
        Title="Choisir une jaquette" Width="860" Height="640" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Text}">
    <Window.Resources>
        <conv:PathToImageConverter x:Key="PathToImage" />
    </Window.Resources>
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.SectionTitle}" FontSize="18" Text="Choisir une jaquette (IGDB)" />
        <DockPanel DockPanel.Dock="Top" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Button.Secondary}" Content="Rechercher" IsDefault="True" Click="OnSearch" />
            <TextBox x:Name="QueryBox" VerticalContentAlignment="Center" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="StatusText" Margin="0,10,0,10" Style="{StaticResource Text.Caption}" />

        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="UseButton" Style="{StaticResource Button.Primary}" Content="Utiliser cette jaquette" Margin="0,0,8,0"
                    IsEnabled="False" Click="OnUse" />
            <Button Style="{StaticResource Button.Secondary}" Content="Annuler" IsCancel="True" />
        </StackPanel>

        <ListBox x:Name="Results" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnDoubleClick"
                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="144" Margin="4">
                        <Border Height="192" CornerRadius="8" Background="{StaticResource Brush.Control}">
                            <Border.Style>
                                <Style TargetType="Border" />
                            </Border.Style>
                            <Grid>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="…" />
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill" ImageSource="{Binding ThumbPath, Converter={StaticResource PathToImage}, ConverterParameter=280}" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Body}" FontSize="13" FontWeight="SemiBold" Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding YearText}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
