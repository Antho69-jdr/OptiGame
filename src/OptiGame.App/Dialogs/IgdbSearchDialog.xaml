<dialogs:DialogWindow x:Class="OptiGame.App.Dialogs.IgdbSearchDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="clr-namespace:OptiGame.App.Dialogs"
                      xmlns:controls="clr-namespace:OptiGame.App.Controls"
                      xmlns:conv="clr-namespace:OptiGame.App.Converters"
                      Title="Choisir une jaquette" Width="860" Height="660" MinWidth="560" MinHeight="420"
                      ResizeMode="CanResize" SizeToContent="Manual">
    <Window.Resources>
        <conv:PathToImageConverter x:Key="PathToImage" />
    </Window.Resources>
    <controls:DialogLayout Heading="Choisir une jaquette" IsBodyScrollable="False"
                           Description="Jaquettes d'IGDB. Seul le nom du jeu est envoyé.">
        <DockPanel>
            <Label DockPanel.Dock="Top" Style="{StaticResource Text.FieldLabel}" Content="_Nom du jeu" Target="{Binding ElementName=QueryBox}" />
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Button.Secondary}" Content="Rechercher" Click="OnSearch" />
                <TextBox x:Name="QueryBox" VerticalContentAlignment="Center" KeyDown="OnQueryKeyDown" AutomationProperties.Name="Nom du jeu" />
            </DockPanel>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="0,10,0,10" Style="{StaticResource Text.Caption}"
                       AutomationProperties.LiveSetting="Polite" />

            <ListBox x:Name="Results" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnDoubleClick" ItemContainerStyle="{StaticResource ListItem.Selectable}"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Jaquettes trouvées">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="144" Margin="4">
                            <Border Height="192" CornerRadius="{StaticResource Radius.Cover}" Background="{StaticResource Brush.CoverPlaceholderMuted}">
                                <Grid>
                                    <TextBlock Margin="8" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                               Style="{StaticResource Text.Caption}" Text="{Binding PreviewText}" />
                                    <Border CornerRadius="{StaticResource Radius.Cover}">
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill" ImageSource="{Binding ThumbPath, Converter={StaticResource PathToImage}, ConverterParameter=280}" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.BodyStrong}" Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding YearText}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <controls:DialogLayout.Footer>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="UseButton" Margin="0,0,8,0" Style="{StaticResource Button.Primary}" Content="Utiliser cette jaquette"
                        IsEnabled="False" IsDefault="True" Click="OnUse" />
                <Button Style="{StaticResource Button.Secondary}" Content="Annuler" IsCancel="True" />
            </StackPanel>
        </controls:DialogLayout.Footer>
    </controls:DialogLayout>
</dialogs:DialogWindow>
