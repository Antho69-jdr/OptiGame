<dialogs:DialogWindow x:Class="OptiGame.App.Dialogs.ProcessPickerDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="clr-namespace:OptiGame.App.Dialogs"
                      xmlns:controls="clr-namespace:OptiGame.App.Controls"
                      Title="Programmes ouverts" Width="580" Height="560" MinWidth="420" MinHeight="320"
                      ResizeMode="CanResize" SizeToContent="Manual">
    <controls:DialogLayout Heading="Programmes à fermer pendant les parties" IsBodyScrollable="False"
                           Description="Cochez les programmes à fermer au lancement du jeu. Les composants de Windows et les services n'apparaissent pas : OptiGame ne les ferme jamais.">
        <ListBox x:Name="List" Style="{StaticResource CheckList}" ItemContainerStyle="{StaticResource CheckList.Item}"
                 SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Programmes ouverts">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding ExeName, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="{Binding Suffix, Mode=OneWay}" Foreground="{StaticResource Brush.TextSecondary}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Path}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <controls:DialogLayout.Footer>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddButton" Margin="0,0,8,0" Style="{StaticResource Button.Primary}" Content="Ajouter" IsEnabled="False" Click="OnOk" />
                <Button Style="{StaticResource Button.Secondary}" Content="Annuler" IsCancel="True" />
            </StackPanel>
        </controls:DialogLayout.Footer>
    </controls:DialogLayout>
</dialogs:DialogWindow>
