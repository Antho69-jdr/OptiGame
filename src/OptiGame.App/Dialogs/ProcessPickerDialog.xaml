<Window x:Class="OptiGame.App.Dialogs.ProcessPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programmes ouverts" Width="560" Height="520" MinHeight="300" MinWidth="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Text}">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Cochez les programmes à fermer au lancement du jeu. Les composants de Windows et les services n'apparaissent pas : OptiGame ne les ferme jamais." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Ajouter la sélection" Style="{StaticResource Button.Primary}" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
            <Button Content="Annuler" Style="{StaticResource Button.Secondary}" IsCancel="True" />
        </StackPanel>
        <ListBox x:Name="List">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="2">
                        <StackPanel>
                            <TextBlock>
                                <Run Text="{Binding ExeName, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding Suffix, Mode=OneWay}" Foreground="{StaticResource Brush.TextSecondary}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Path}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
