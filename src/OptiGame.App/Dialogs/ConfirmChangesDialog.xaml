<dialogs:DialogWindow x:Class="OptiGame.App.Dialogs.ConfirmChangesDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="clr-namespace:OptiGame.App.Dialogs"
                      xmlns:controls="clr-namespace:OptiGame.App.Controls"
                      Title="Confirmer les optimisations" Width="640">
    <controls:DialogLayout x:Name="Layout"
                           Description="Chaque réglage d'origine est sauvegardé avant d'être modifié : vous pourrez tout restaurer depuis la page Diagnostic.">
        <ItemsControl x:Name="ChangesList" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="{StaticResource Margin.StackS}" Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Title}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding Why}" />
                            <controls:RequirementBadges Margin="0,8,0,0" RequiresAdmin="{Binding RequiresAdmin}" RequiresReboot="{Binding RequiresReboot}" />
                            <Expander Margin="0,4,0,0" Style="{StaticResource Expander.Disclosure}" Header="Détails techniques"
                                      AutomationProperties.Name="{Binding Title, StringFormat='Détails techniques : {0}'}">
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Mono}" Text="{Binding What}" />
                            </Expander>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <controls:DialogLayout.Footer>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ApplyButton" Margin="0,0,8,0" Style="{StaticResource Button.Primary}" Click="OnApply" />
                <Button x:Name="CancelButton" Style="{StaticResource Button.Secondary}" Content="Annuler" IsCancel="True" IsDefault="True" />
            </StackPanel>
        </controls:DialogLayout.Footer>
    </controls:DialogLayout>
</dialogs:DialogWindow>
