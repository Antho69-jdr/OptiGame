<Window x:Class="OptiGame.App.Dialogs.ConfirmChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmer les optimisations" Width="640" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Text}">
    <DockPanel Margin="24">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" Style="{StaticResource Text.SectionTitle}" FontSize="18" />
        <TextBlock DockPanel.Dock="Top" Margin="0,6,0,0" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                   Text="Chaque modification est sauvegardée avant d'être appliquée : « Désactiver les optimisations » (ou l'onglet Avancé) rétablit l'état d'origine." />

        <StackPanel DockPanel.Dock="Bottom">
            <StackPanel Margin="0,16,0,0">
                <TextBlock x:Name="AdminText" Style="{StaticResource Text.Secondary}" Text="• Certaines nécessitent les droits administrateur." />
                <TextBlock x:Name="RebootText" Style="{StaticResource Text.Secondary}" Text="• Certaines ne sont prises en compte qu'après un redémarrage de Windows." />
            </StackPanel>
            <StackPanel Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ApplyButton" Style="{StaticResource Button.Primary}" Margin="0,0,8,0" Click="OnApply" />
                <Button Style="{StaticResource Button.Secondary}" Content="Annuler" IsCancel="True" IsDefault="True" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ChangesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="14,10" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Card}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Badges}" />
                                    <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                </DockPanel>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Mono}" Text="{Binding What}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Why}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
